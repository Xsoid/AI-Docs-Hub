# Optional RAGFlow profile.
#
# This is intentionally not part of the default docker-compose.yml because the
# current machine is macOS arm64 and RAGFlow can be heavy or image-dependent.
# Before using this file, verify the official RAGFlow installation notes and
# arm64 image support for your exact version.
#
# Example command after verification:
#   docker compose -f docker-compose.ragflow.yml.example --profile ragflow up
#
# The lite RAG backend in rag/ is the default working backend for this hub.
services:
  ragflow:
    image: infiniflow/ragflow:latest
    profiles:
      - ragflow
    ports:
      - "9380:9380"
    volumes:
      - ./storage/ragflow:/ragflow/storage
    environment:
      TZ: Europe/Samara

