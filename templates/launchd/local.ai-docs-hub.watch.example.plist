<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.ai-docs-hub.watch.example-project</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON3_11__</string>
    <string>__AI_DOCS_HUB_ROOT__/scripts/watch-project</string>
    <string>--project</string>
    <string>example-project</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__AI_DOCS_HUB_ROOT__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__AI_DOCS_HUB_ROOT__/storage/watch-example-project.out.log</string>

  <key>StandardErrorPath</key>
  <string>__AI_DOCS_HUB_ROOT__/storage/watch-example-project.err.log</string>
</dict>
</plist>
