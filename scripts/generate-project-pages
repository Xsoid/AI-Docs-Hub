#!/usr/bin/env python3.11
from __future__ import annotations

import json
import shutil
import sys
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from rag.config import HUB_ROOT, is_unbound_example_config, load_project_configs, validate_project_config  # noqa: E402
from rag.docs_quality import documentation_readiness  # noqa: E402
from rag.sources import build_source_plan  # noqa: E402


PROJECTS_DOCS_DIR = HUB_ROOT / "docs-site" / "src" / "content" / "docs" / "projects"
GENERATED_MARKER = "<!-- Generated by scripts/generate-project-pages. Do not edit manually. -->"


def escape_frontmatter(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def load_index_summary(index_path: Path) -> dict[str, Any] | None:
    if not index_path.exists():
        return None
    try:
        return json.loads(index_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return None


def render_sources(sources: list[dict[str, Any]]) -> list[str]:
    if not sources:
        return ["- No sources configured."]
    lines: list[str] = []
    for source in sources:
        path = str(source.get("path", "")).strip()
        source_type = str(source.get("type", "")).strip()
        if path and source_type:
            lines.append(f"- `{path}` ({source_type})")
        elif path:
            lines.append(f"- `{path}`")
    return lines or ["- No sources configured."]


def render_readiness(readiness: dict[str, Any]) -> list[str]:
    recommendations = readiness.get("recommendations", [])
    if not recommendations:
        return ["- Documentation structure matches the hub recommendations."]
    return [f"- {recommendation}" for recommendation in recommendations]


def render_agent_rules(agent_rules: list[str]) -> list[str]:
    if not agent_rules:
        return ["- No project-specific agent rules configured."]
    return [f"- {rule}" for rule in agent_rules]


def render_project_page(config: Any) -> str:
    issues = validate_project_config(config)
    errors = [issue for issue in issues if issue["level"] == "error"]
    warnings = [issue for issue in issues if issue["level"] == "warning"]
    recommendations = [issue for issue in issues if issue["level"] == "recommendation"]
    source_plan = build_source_plan(config)
    readiness = documentation_readiness(config)
    index = load_index_summary(config.index_path)

    status = "configured"
    if errors:
        status = "config error"
    elif warnings:
        status = "configured with warnings"
    if index:
        status = "indexed"

    lines = [
        "---",
        f"title: {escape_frontmatter(config.title)}",
        f"description: {escape_frontmatter(f'Derived project entry for {config.title}.')}",
        "---",
        "",
        GENERATED_MARKER,
        "",
        f"Derived project entry for `{config.project}`.",
        "",
        "The source of truth is the external project documentation. The hub stores only config, indexes, and derived context.",
        "",
        "## Project",
        "",
        f"- Namespace: `{config.namespace}`",
        f"- Root: `{config.root_source}`",
        f"- Docs backend: `{config.docs_backend}`",
        f"- Status: `{status}`",
        f"- Documentation coverage: `{readiness.get('coverage', {}).get('percent', 0)}%`",
    ]

    if index:
        lines.extend(
            [
                f"- Indexed documents: `{index.get('documents_count', 0)}`",
                f"- Indexed chunks: `{index.get('chunks_count', 0)}`",
                f"- Indexed at: `{index.get('indexed_at', 'unknown')}`",
            ]
        )

    if source_plan.mkdocs.detected:
        lines.extend(
            [
                f"- MkDocs config: `{source_plan.mkdocs.config_path}`",
                f"- MkDocs docs_dir: `{source_plan.mkdocs.docs_dir or '.'}`",
            ]
        )

    lines.extend(["", "## Sources", "", *render_sources(source_plan.sources), ""])

    if warnings or errors:
        lines.extend(["## Config Notes", ""])
        for issue in [*errors, *warnings]:
            lines.append(f"- `{issue['level']}`: {issue['message']}")
        lines.append("")

    if recommendations:
        lines.extend(["## Documentation Readiness", "", *render_readiness(readiness), ""])

    lines.extend(
        [
            "## Agent Rules",
            "",
            *render_agent_rules(config.agent_rules),
            "",
            "Use MCP tools or the Lite RAG index for project-scoped search.",
            "",
        ]
    )
    return "\n".join(lines)


def remove_stale_generated_dirs(active_projects: set[str]) -> None:
    if not PROJECTS_DOCS_DIR.exists():
        return
    for child in PROJECTS_DOCS_DIR.iterdir():
        if not child.is_dir() or child.name in active_projects:
            continue
        overview = child / "overview.md"
        if overview.exists() and GENERATED_MARKER in overview.read_text(encoding="utf-8", errors="replace"):
            shutil.rmtree(child)


def main() -> int:
    PROJECTS_DOCS_DIR.mkdir(parents=True, exist_ok=True)
    configs = load_project_configs()
    active_projects = {
        name for name, config in configs.items() if not is_unbound_example_config(config)
    }
    remove_stale_generated_dirs(active_projects)

    written: list[str] = []
    skipped: list[str] = []
    for name, config in sorted(configs.items()):
        if is_unbound_example_config(config):
            skipped.append(name)
            continue
        project_dir = PROJECTS_DOCS_DIR / name
        project_dir.mkdir(parents=True, exist_ok=True)
        output = project_dir / "overview.md"
        output.write_text(render_project_page(config), encoding="utf-8")
        written.append(str(output.relative_to(HUB_ROOT)))

    print(json.dumps({"written": written, "skipped": skipped}, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
