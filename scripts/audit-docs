#!/usr/bin/env python3.11
"""Audit Hub documentation ownership, links, and local writing guidance.

The audit has no network dependency and never changes documentation. Errors are
release blockers. Warnings identify writing and duplication candidates for a
human reviewer; they are deliberately not machine-fixed.
"""
from __future__ import annotations

import json
import re
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DOCS = ROOT / "docs"
SITE = ROOT / "docs-site" / "src" / "content" / "docs"
MARKER = "<!-- Generated by scripts/generate-hub-pages. Do not edit manually. -->"
SITE_ONLY = {
    SITE / "index.md",
    SITE / "hub" / "agent-rules.md",
    SITE / "hub" / "autonomous-setup.md",
    SITE / "hub" / "overview.md",
    SITE / "hub" / "usage.md",
}
LINK = re.compile(r"(?<!!)\[[^\]]+\]\(([^)\s]+)\)")
SENTENCE = re.compile(r"[^.!?\n]{181,}[.!?]", re.UNICODE)


def markdown_files() -> list[Path]:
    paths = list(DOCS.rglob("*.md"))
    paths.extend([ROOT / "README.md", ROOT / "AGENTS.md"])
    paths.extend((ROOT / ".agents" / "skills").glob("**/*.md"))
    paths.extend((ROOT / "templates" / "project-docs").glob("**/*.md"))
    paths.extend(SITE_ONLY)
    return sorted(path for path in paths if path.exists())


def stripped_lines(text: str) -> str:
    """Remove fenced code before prose-only advisory checks."""
    return re.sub(r"^```.*?^```", "", text, flags=re.MULTILINE | re.DOTALL)


def target_exists(source: Path, href: str) -> bool:
    if href.startswith(("http://", "https://", "mailto:", "#", "/")):
        return True
    target = href.split("#", 1)[0]
    if not target:
        return True
    candidate = (source.parent / target).resolve()
    return candidate.exists() or candidate.with_suffix(".md").exists()


def audit() -> dict[str, object]:
    errors: list[dict[str, str]] = []
    warnings: list[dict[str, str]] = []
    required = {
        DOCS / "architecture" / "overview.md",
        DOCS / "standards" / "documentation-hygiene.md",
        DOCS / "standards" / "technical-writing.md",
        DOCS / "operations" / "command-reference.md",
    }
    for path in sorted(required):
        if not path.exists():
            errors.append({"code": "missing_canonical_document", "path": path.relative_to(ROOT).as_posix()})

    for path in markdown_files():
        raw = path.read_text(encoding="utf-8")
        rel = path.relative_to(ROOT).as_posix()
        for href in LINK.findall(raw):
            if not target_exists(path, href):
                errors.append({"code": "broken_internal_link", "path": rel, "target": href})
        prose = stripped_lines(raw)
        is_history = path.is_relative_to(DOCS / "changes") or path.is_relative_to(DOCS / "decisions")
        if not is_history and SENTENCE.search(prose):
            warnings.append({"code": "long_sentence", "path": rel, "message": "Review prose sentence longer than 180 characters."})

    for path in SITE_ONLY:
        if path.exists() and MARKER in path.read_text(encoding="utf-8"):
            errors.append({"code": "site_only_has_generated_marker", "path": path.relative_to(ROOT).as_posix()})

    for directory in (SITE / "hub", SITE / "standards"):
        if directory.exists():
            for path in directory.rglob("*.md"):
                if path not in SITE_ONLY and MARKER not in path.read_text(encoding="utf-8"):
                    errors.append({"code": "unowned_site_page", "path": path.relative_to(ROOT).as_posix()})

    return {"status": "passed" if not errors else "failed", "errors": errors, "warnings": warnings}


def main() -> int:
    strict = sys.argv[1:] == ["--strict"]
    if not strict and sys.argv[1:]:
        raise SystemExit("usage: audit-docs [--strict]")
    report = audit()
    print(json.dumps(report, ensure_ascii=False, indent=2))
    return 0 if not report["errors"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
