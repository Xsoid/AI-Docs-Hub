#!/usr/bin/env python3.11
from __future__ import annotations

import argparse
import json
import os
import queue
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import urllib.parse
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
RUNTIME_DIR = ROOT / "storage" / "runtime"
STATUS_PATH = RUNTIME_DIR / "hub-dev.status.json"


@dataclass
class Child:
    name: str
    command: list[str]
    process: subprocess.Popen[str]


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def log(component: str, message: str) -> None:
    print(f"[{component}] {message}", flush=True)


def run_startup_step(name: str, command: list[str]) -> None:
    log("hub", f"running {name}: {' '.join(command)}")
    result = subprocess.run(
        command,
        cwd=str(ROOT),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if result.stdout.strip():
        for line in result.stdout.splitlines():
            log(name, line)
    if result.returncode != 0:
        raise RuntimeError(f"{name} exited with code {result.returncode}")


def start_child(name: str, command: list[str]) -> Child:
    process = subprocess.Popen(
        command,
        cwd=str(ROOT),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        bufsize=1,
        start_new_session=True,
    )
    log("hub", f"started {name} pid {process.pid}")
    return Child(name=name, command=command, process=process)


def reader(child: Child, output: queue.Queue[tuple[str, str | None]]) -> None:
    assert child.process.stdout is not None
    for line in child.process.stdout:
        output.put((child.name, line.rstrip()))
    output.put((child.name, None))


def docs_site_ok(url: str, timeout: float = 1.5) -> tuple[bool, str]:
    request = urllib.request.Request(url, method="HEAD")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            status_code = response.status
    except urllib.error.HTTPError as exc:
        status_code = exc.code
    except urllib.error.URLError as exc:
        reason = getattr(exc, "reason", exc)
        return False, str(reason)
    except (TimeoutError, socket.timeout) as exc:
        return False, f"timeout: {exc}"
    if 200 <= status_code < 400:
        return True, f"HTTP {status_code}"
    return False, f"HTTP {status_code}"


def docs_site_tcp_ok(url: str, timeout: float = 1.5) -> tuple[bool, str]:
    parsed = urllib.parse.urlparse(url)
    host = parsed.hostname or "localhost"
    port = parsed.port or 80
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True, f"TCP {host}:{port}"
    except OSError as exc:
        return False, str(exc)


def child_state(child: Child | None) -> dict[str, Any] | None:
    if child is None:
        return None
    return_code = child.process.poll()
    return {
        "pid": child.process.pid,
        "status": "running" if return_code is None else "exited",
        "returncode": return_code,
        "command": child.command,
    }


def write_status(
    status: str,
    docs: Child | None,
    watcher: Child | None,
    fix_server: Child | None,
    docs_url: str,
    health_url: str,
    docs_http: str,
    message: str,
) -> None:
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    children: dict[str, Any] = {}
    docs_state = child_state(docs)
    watcher_state = child_state(watcher)
    fix_server_state = child_state(fix_server)
    if docs_state is not None:
        docs_state["url"] = docs_url
        docs_state["health_url"] = health_url
        docs_state["http"] = docs_http
        children["docs-site"] = docs_state
    if watcher_state is not None:
        children["watcher"] = watcher_state
    if fix_server_state is not None:
        fix_server_state["url"] = "http://127.0.0.1:4322/"
        children["fix-server"] = fix_server_state
    payload = {
        "status": status,
        "pid": os.getpid(),
        "checked_at": utc_now(),
        "message": message,
        "children": children,
    }
    tmp = STATUS_PATH.with_suffix(".tmp")
    tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(STATUS_PATH)


def terminate_child(child: Child) -> None:
    if child.process.poll() is not None:
        return
    log("hub", f"stopping {child.name} pid {child.process.pid}")
    try:
        os.killpg(child.process.pid, signal.SIGTERM)
    except OSError:
        child.process.terminate()


def kill_child(child: Child) -> None:
    if child.process.poll() is not None:
        return
    log("hub", f"killing {child.name} pid {child.process.pid}")
    try:
        os.killpg(child.process.pid, signal.SIGKILL)
    except OSError:
        child.process.kill()


def stop_children(children: list[Child]) -> None:
    for child in children:
        terminate_child(child)
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        if all(child.process.poll() is not None for child in children):
            return
        time.sleep(0.1)
    for child in children:
        kill_child(child)


def main() -> int:
    parser = argparse.ArgumentParser(description="Run AI Docs Hub foreground runtime.")
    parser.add_argument("--host", default="0.0.0.0", help="Docs-site host passed to Astro.")
    parser.add_argument("--port", type=int, default=4321, help="Docs-site port passed to Astro.")
    parser.add_argument("--no-watch", action="store_true", help="Do not start watch-all.")
    parser.add_argument("--no-fix-server", action="store_true", help="Do not start local fix action server.")
    parser.add_argument("--startup-timeout", type=float, default=30.0, help="Seconds to wait for docs-site.")
    args = parser.parse_args()

    docs_url = f"http://localhost:{args.port}/"
    docs_health_url = f"http://localhost:{args.port}/status/"
    stop_requested = {"value": False, "signal": None}

    def handle_signal(signum: int, _frame: Any) -> None:
        stop_requested["value"] = True
        stop_requested["signal"] = signum

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    docs: Child | None = None
    watcher: Child | None = None
    fix_server: Child | None = None
    children: list[Child] = []
    output: queue.Queue[tuple[str, str | None]] = queue.Queue()
    docs_seen_ok = False
    docs_started_at = time.monotonic()
    docs_down_since: float | None = None
    exit_code = 0
    final_message = "stopped"

    try:
        run_startup_step("project-pages", [sys.executable, str(ROOT / "scripts" / "generate-project-pages")])
        docs = start_child(
            "docs",
            [
                str(ROOT / "scripts" / "docs-npm"),
                "run",
                "dev",
                "--",
                "--host",
                args.host,
                "--port",
                str(args.port),
            ],
        )
        children.append(docs)
        threading.Thread(target=reader, args=(docs, output), daemon=True).start()

        if not args.no_watch:
            watcher = start_child("watch", [sys.executable, str(ROOT / "scripts" / "watch-project"), "--all"])
            children.append(watcher)
            threading.Thread(target=reader, args=(watcher, output), daemon=True).start()

        if not args.no_fix_server:
            fix_server = start_child("fix", [sys.executable, str(ROOT / "scripts" / "fix-server")])
            children.append(fix_server)
            threading.Thread(target=reader, args=(fix_server, output), daemon=True).start()

        log("hub", f"runtime starting; docs-site target is {docs_url}, health is {docs_health_url}")
        while True:
            while True:
                try:
                    component, line = output.get_nowait()
                except queue.Empty:
                    break
                if line is not None:
                    if component == "watch" and line.startswith("[watch] "):
                        line = line[len("[watch] ") :]
                    log(component, line)

            for child in children:
                return_code = child.process.poll()
                if return_code is not None:
                    final_message = f"{child.name} exited with code {return_code}"
                    log("hub", final_message)
                    exit_code = 1 if return_code == 0 else return_code
                    raise RuntimeError(final_message)

            ok, docs_http = docs_site_tcp_ok(docs_url)
            if ok:
                if not docs_seen_ok:
                    log("hub", f"docs-site is listening at {docs_url} ({docs_http})")
                docs_seen_ok = True
                docs_down_since = None
            else:
                if not docs_seen_ok and time.monotonic() - docs_started_at > args.startup_timeout:
                    final_message = f"docs-site did not become ready: {docs_http}"
                    log("hub", final_message)
                    exit_code = 1
                    raise RuntimeError(final_message)
                if docs_seen_ok:
                    docs_down_since = docs_down_since or time.monotonic()
                    if time.monotonic() - docs_down_since > 5:
                        final_message = f"docs-site became unavailable: {docs_http}"
                        log("hub", final_message)
                        exit_code = 1
                        raise RuntimeError(final_message)

            write_status("running", docs, watcher, fix_server, docs_url, docs_health_url, docs_http, "running")

            if stop_requested["value"]:
                signum = stop_requested["signal"]
                final_message = f"received signal {signum}"
                log("hub", final_message)
                exit_code = 130 if signum == signal.SIGINT else 143
                break

            time.sleep(1)
    except KeyboardInterrupt:
        final_message = "interrupted"
        exit_code = 130
    except RuntimeError:
        if exit_code == 0:
            exit_code = 1
    finally:
        stop_children(children)
        write_status("stopped", docs, watcher, fix_server, docs_url, docs_health_url, "stopped", final_message)
        log("hub", f"status: stopped ({final_message})")
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
