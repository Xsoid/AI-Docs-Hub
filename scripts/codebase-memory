#!/usr/bin/env python3.11
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from rag.config import get_project_config  # noqa: E402


DEFAULT_BINARY = ROOT / "storage" / "runtime" / "bin" / "codebase-memory-mcp"
DEFAULT_CACHE_DIR = ROOT / "storage" / "codebase-memory"
STATUS_DIR = ROOT / "storage" / "runtime" / "codebase-memory"
REQUIRED_IGNORE_PATTERNS = (
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "**/*secret*",
    "**/*token*",
    "**/*password*",
    "**/*credential*",
    "**/*cookie*",
    "**/*session*",
    "**/*dump*",
    "**/*.key",
    "**/*.pem",
    "**/*.p12",
    "**/*.pfx",
)
READ_ONLY_TOOLS = {
    "detect_changes",
    "get_architecture",
    "get_code_snippet",
    "get_graph_schema",
    "index_status",
    "query_graph",
    "search_code",
    "search_graph",
    "trace_call_path",
    "trace_path",
}


def binary_path() -> Path:
    configured = os.environ.get("CODEBASE_MEMORY_BIN", "").strip()
    return Path(configured).expanduser() if configured else DEFAULT_BINARY


def runtime_env() -> dict[str, str]:
    env = os.environ.copy()
    env["CBM_CACHE_DIR"] = str(Path(env.get("CBM_CACHE_DIR", DEFAULT_CACHE_DIR)).expanduser())
    return env


def run_binary(arguments: list[str], *, timeout: float | None = None) -> subprocess.CompletedProcess[str]:
    binary = binary_path()
    if not binary.exists():
        raise FileNotFoundError(
            f"Codebase Memory binary is missing at {binary}. Run: make codebase-memory-install"
        )
    return subprocess.run(
        [str(binary), *arguments],
        cwd=str(ROOT),
        env=runtime_env(),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        check=False,
    )


def parse_json_stdout(result: subprocess.CompletedProcess[str]) -> dict[str, Any]:
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout).strip() or f"exit code {result.returncode}")
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid JSON from Codebase Memory: {exc}") from exc
    if not isinstance(payload, dict):
        raise RuntimeError("Codebase Memory JSON root is not an object")
    return payload


def read_ignore_patterns(root: Path) -> set[str]:
    path = root / ".cbmignore"
    if not path.exists():
        raise ValueError(f"{path} is required before indexing")
    patterns: set[str] = set()
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if line and not line.startswith("#") and not line.startswith("!"):
            patterns.add(line)
    missing = [pattern for pattern in REQUIRED_IGNORE_PATTERNS if pattern not in patterns]
    if missing:
        raise ValueError(f"{path} is missing required secret exclusions: {', '.join(missing)}")
    return patterns


def project_context(project: str) -> tuple[Any, Path]:
    config = get_project_config(project)
    root = config.root.resolve()
    if not root.exists() or not root.is_dir():
        raise ValueError(f"project root does not exist: {root}")
    read_ignore_patterns(root)
    return config, root


def command_index(args: argparse.Namespace) -> int:
    config, root = project_context(args.project)
    result = run_binary(
        [
            "cli",
            "index_repository",
            "--repo-path",
            str(root),
            "--name",
            config.project,
            "--mode",
            args.mode,
            "--persistence",
            "false",
        ],
        timeout=args.timeout,
    )
    sys.stderr.write(result.stderr)
    sys.stdout.write(result.stdout)
    return result.returncode


def command_status(args: argparse.Namespace) -> int:
    binary = binary_path()
    cache_dir = Path(runtime_env()["CBM_CACHE_DIR"])
    details: dict[str, Any] = {
        "binary": str(binary),
        "binary_exists": binary.exists(),
        "cache_dir": str(cache_dir),
        "cache_exists": cache_dir.exists(),
        "project": args.project,
    }
    if not binary.exists():
        details.update({"status": "missing", "message": "binary is not installed"})
        print(json.dumps(details, ensure_ascii=False, indent=2))
        return 2
    version = run_binary(["--version"], timeout=args.timeout)
    details["version"] = (version.stdout or version.stderr).strip()
    try:
        _, root = project_context(args.project)
        details["root"] = str(root)
        details["ignore_policy"] = "ok"
        result = run_binary(["cli", "index_status", "--project", args.project], timeout=args.timeout)
        index = parse_json_stdout(result)
        details["index"] = index
        details["status"] = "indexed"
        details["message"] = "binary and project graph are ready"
        exit_code = 0
    except (ValueError, RuntimeError, subprocess.TimeoutExpired) as exc:
        message = str(exc)
        details["status"] = "not-indexed" if "not indexed" in message.lower() else "warning"
        details["message"] = message
        exit_code = 2
    STATUS_DIR.mkdir(parents=True, exist_ok=True)
    (STATUS_DIR / f"{args.project}.status.json").write_text(
        json.dumps(details, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    print(json.dumps(details, ensure_ascii=False, indent=2))
    return exit_code


def command_tool(args: argparse.Namespace) -> int:
    project_context(args.project)
    if args.tool not in READ_ONLY_TOOLS:
        raise ValueError(f"tool is not allowlisted for the Hub wrapper: {args.tool}")
    payload = json.loads(args.arguments)
    if not isinstance(payload, dict):
        raise ValueError("tool arguments must be a JSON object")
    payload["project"] = args.project
    result = run_binary(["cli", args.tool, json.dumps(payload, ensure_ascii=False)], timeout=args.timeout)
    sys.stderr.write(result.stderr)
    sys.stdout.write(result.stdout)
    return result.returncode


def main() -> int:
    parser = argparse.ArgumentParser(description="Scoped Codebase Memory integration for AI Docs Hub.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    status = subparsers.add_parser("status", help="Check binary, ignore policy, and one project graph.")
    status.add_argument("--project", required=True)
    status.add_argument("--timeout", type=float, default=8.0)
    status.set_defaults(handler=command_status)

    index = subparsers.add_parser("index", help="Index a configured project without repository persistence.")
    index.add_argument("--project", required=True)
    index.add_argument("--mode", choices=("fast", "moderate", "full"), default="moderate")
    index.add_argument("--timeout", type=float, default=900.0)
    index.set_defaults(handler=command_index)

    tool = subparsers.add_parser("tool", help="Run a read-oriented Codebase Memory CLI tool.")
    tool.add_argument("--project", required=True)
    tool.add_argument("--tool", required=True)
    tool.add_argument("--arguments", default="{}")
    tool.add_argument("--timeout", type=float, default=30.0)
    tool.set_defaults(handler=command_tool)

    args = parser.parse_args()
    try:
        return int(args.handler(args))
    except (FileNotFoundError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
