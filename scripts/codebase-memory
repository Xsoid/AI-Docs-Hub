#!/usr/bin/env python3.11
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tomllib
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from rag.config import get_project_config  # noqa: E402


DEFAULT_BINARY = ROOT / "storage" / "runtime" / "bin" / "codebase-memory-mcp"
DEFAULT_CACHE_DIR = ROOT / "storage" / "codebase-memory"
STATUS_DIR = ROOT / "storage" / "runtime" / "codebase-memory"
CODEX_CONFIG = Path.home() / ".codex" / "config.toml"
AGENT_RULES_BEGIN = "<!-- BEGIN AI DOCS HUB CODEBASE MEMORY -->"
AGENT_RULES_END = "<!-- END AI DOCS HUB CODEBASE MEMORY -->"
REQUIRED_IGNORE_PATTERNS = (
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "**/*secret*",
    "**/*token*",
    "**/*password*",
    "**/*credential*",
    "**/*cookie*",
    "**/*session*",
    "**/*dump*",
    "**/*.key",
    "**/*.pem",
    "**/*.p12",
    "**/*.pfx",
)
READ_ONLY_TOOLS = {
    "detect_changes",
    "get_architecture",
    "get_code_snippet",
    "get_graph_schema",
    "index_status",
    "query_graph",
    "search_code",
    "search_graph",
    "trace_call_path",
    "trace_path",
}


def binary_path() -> Path:
    configured = os.environ.get("CODEBASE_MEMORY_BIN", "").strip()
    return Path(configured).expanduser() if configured else DEFAULT_BINARY


def runtime_env() -> dict[str, str]:
    env = os.environ.copy()
    env["CBM_CACHE_DIR"] = str(Path(env.get("CBM_CACHE_DIR", DEFAULT_CACHE_DIR)).expanduser())
    return env


def run_binary(arguments: list[str], *, timeout: float | None = None) -> subprocess.CompletedProcess[str]:
    binary = binary_path()
    if not binary.exists():
        raise FileNotFoundError(
            f"Codebase Memory binary is missing at {binary}. Run: make codebase-memory-install"
        )
    return subprocess.run(
        [str(binary), *arguments],
        cwd=str(ROOT),
        env=runtime_env(),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        check=False,
    )


def parse_json_stdout(result: subprocess.CompletedProcess[str]) -> dict[str, Any]:
    if result.returncode != 0:
        raise RuntimeError((result.stderr or result.stdout).strip() or f"exit code {result.returncode}")
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid JSON from Codebase Memory: {exc}") from exc
    if not isinstance(payload, dict):
        raise RuntimeError("Codebase Memory JSON root is not an object")
    return payload


def read_ignore_patterns(root: Path) -> set[str]:
    path = root / ".cbmignore"
    if not path.exists():
        raise ValueError(f"{path} is required before indexing")
    patterns: set[str] = set()
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if line and not line.startswith("#") and not line.startswith("!"):
            patterns.add(line)
    missing = [pattern for pattern in REQUIRED_IGNORE_PATTERNS if pattern not in patterns]
    if missing:
        raise ValueError(f"{path} is missing required secret exclusions: {', '.join(missing)}")
    return patterns


def project_context(project: str) -> tuple[Any, Path]:
    config = get_project_config(project)
    root = config.root.resolve()
    if not root.exists() or not root.is_dir():
        raise ValueError(f"project root does not exist: {root}")
    read_ignore_patterns(root)
    return config, root


def server_name(project: str) -> str:
    return "codebase_" + "".join(char if char.isalnum() else "_" for char in project).strip("_")


def managed_config_markers(project: str) -> tuple[str, str]:
    return (
        f"# BEGIN AI DOCS HUB CODEBASE MEMORY: {project}",
        f"# END AI DOCS HUB CODEBASE MEMORY: {project}",
    )


def managed_mcp_block(project: str) -> str:
    begin, end = managed_config_markers(project)
    name = server_name(project)
    return (
        f"{begin}\n"
        f"[mcp_servers.{name}]\n"
        f'command = "{sys.executable}"\n'
        f'args = ["{ROOT / "mcp" / "codebase_memory_proxy.py"}", "--project", "{project}"]\n'
        "startup_timeout_sec = 120\n\n"
        f"[mcp_servers.{name}.env]\n"
        f'CBM_CACHE_DIR = "{Path(runtime_env()["CBM_CACHE_DIR"])}"\n'
        f"{end}\n"
    )


def replace_managed_block(text: str, begin: str, end: str, block: str) -> str:
    pattern = re.compile(rf"(?:^|\n){re.escape(begin)}\n.*?\n{re.escape(end)}\n?", re.DOTALL)
    cleaned = pattern.sub("\n", text).rstrip()
    return f"{cleaned}\n\n{block}" if cleaned else block


def remove_legacy_codebase_server(text: str) -> str:
    legacy_headers = {"[mcp_servers.codebase_memory]", "[mcp_servers.codebase_memory.env]"}
    output: list[str] = []
    skipping = False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            skipping = stripped in legacy_headers
        if not skipping:
            output.append(line)
    return "\n".join(output).rstrip() + "\n"


def agent_rules_block(project: str) -> str:
    return (
        f"{AGENT_RULES_BEGIN}\n"
        "## Codebase Memory\n\n"
        f"- Для этого проекта Codebase Memory используется только с project scope `{project}`.\n"
        "- Документацию, ADR, runbooks и project policies сначала искать через AI Docs Hub.\n"
        "- Для symbols, definitions, calls, dependencies, routes и blast radius сначала использовать Codebase Memory MCP.\n"
        "- Обычные `rg` и чтение файлов остаются fallback, если graph coverage неполный или нужен source of truth.\n"
        "- `manage_adr`, cross-project wildcard, `delete_project`, `ingest_traces` и repository persistence запрещены.\n"
        "- Если документация и code graph расходятся, проверить исходный код и явно сообщить о конфликте с путями.\n"
        "- После первого подключения или изменения MCP-конфигурации перезапустить Codex, чтобы новая сессия загрузила server tools.\n"
        f"{AGENT_RULES_END}\n"
    )


def mcp_is_configured(project: str) -> bool:
    if not CODEX_CONFIG.exists():
        return False
    text = CODEX_CONFIG.read_text(encoding="utf-8")
    begin, end = managed_config_markers(project)
    if begin not in text or end not in text:
        return False
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        return False
    server = (data.get("mcp_servers") or {}).get(server_name(project), {})
    expected_args = [str(ROOT / "mcp" / "codebase_memory_proxy.py"), "--project", project]
    return bool(
        server.get("command") == sys.executable
        and server.get("args") == expected_args
        and (server.get("env") or {}).get("CBM_CACHE_DIR") == str(Path(runtime_env()["CBM_CACHE_DIR"]))
    )


def agent_rules_are_installed(root: Path) -> bool:
    path = root / "AGENTS.md"
    if not path.exists():
        return False
    text = path.read_text(encoding="utf-8")
    return AGENT_RULES_BEGIN in text and AGENT_RULES_END in text


def configure_project(project: str) -> dict[str, Any]:
    _, root = project_context(project)
    CODEX_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    config_text = CODEX_CONFIG.read_text(encoding="utf-8") if CODEX_CONFIG.exists() else ""
    config_text = remove_legacy_codebase_server(config_text)
    begin, end = managed_config_markers(project)
    CODEX_CONFIG.write_text(
        replace_managed_block(config_text, begin, end, managed_mcp_block(project)),
        encoding="utf-8",
    )

    agents_path = root / "AGENTS.md"
    agents_text = agents_path.read_text(encoding="utf-8") if agents_path.exists() else f"# Agent Rules: {project}\n"
    agents_path.write_text(
        replace_managed_block(agents_text, AGENT_RULES_BEGIN, AGENT_RULES_END, agent_rules_block(project)),
        encoding="utf-8",
    )
    return {
        "project": project,
        "mcp_server": server_name(project),
        "mcp_configured": mcp_is_configured(project),
        "agent_rules_installed": agent_rules_are_installed(root),
        "restart_required": True,
        "agents_path": str(agents_path),
        "codex_config": str(CODEX_CONFIG),
    }


def command_index(args: argparse.Namespace) -> int:
    config, root = project_context(args.project)
    result = run_binary(
        [
            "cli",
            "index_repository",
            "--repo-path",
            str(root),
            "--name",
            config.project,
            "--mode",
            args.mode,
            "--persistence",
            "false",
        ],
        timeout=args.timeout,
    )
    sys.stderr.write(result.stderr)
    sys.stdout.write(result.stdout)
    return result.returncode


def command_status(args: argparse.Namespace) -> int:
    binary = binary_path()
    cache_dir = Path(runtime_env()["CBM_CACHE_DIR"])
    details: dict[str, Any] = {
        "binary": str(binary),
        "binary_exists": binary.exists(),
        "cache_dir": str(cache_dir),
        "cache_exists": cache_dir.exists(),
        "project": args.project,
    }
    if not binary.exists():
        details.update({"status": "missing", "message": "binary is not installed"})
        print(json.dumps(details, ensure_ascii=False, indent=2))
        return 2
    version = run_binary(["--version"], timeout=args.timeout)
    details["version"] = (version.stdout or version.stderr).strip()
    try:
        _, root = project_context(args.project)
        details["root"] = str(root)
        details["ignore_policy"] = "ok"
        details["mcp_server"] = server_name(args.project)
        details["mcp_configured"] = mcp_is_configured(args.project)
        details["agent_rules_installed"] = agent_rules_are_installed(root)
        details["fully_connected"] = bool(
            details["mcp_configured"] and details["agent_rules_installed"]
        )
        result = run_binary(["cli", "index_status", "--project", args.project], timeout=args.timeout)
        index = parse_json_stdout(result)
        details["index"] = index
        details["status"] = "indexed"
        details["message"] = "binary and project graph are ready"
        exit_code = 0
    except (ValueError, RuntimeError, subprocess.TimeoutExpired) as exc:
        message = str(exc)
        details["status"] = "not-indexed" if "not indexed" in message.lower() else "warning"
        details["message"] = message
        exit_code = 2
    STATUS_DIR.mkdir(parents=True, exist_ok=True)
    (STATUS_DIR / f"{args.project}.status.json").write_text(
        json.dumps(details, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    print(json.dumps(details, ensure_ascii=False, indent=2))
    return exit_code


def command_configure(args: argparse.Namespace) -> int:
    result = configure_project(args.project)
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0


def command_tool(args: argparse.Namespace) -> int:
    project_context(args.project)
    if args.tool not in READ_ONLY_TOOLS:
        raise ValueError(f"tool is not allowlisted for the Hub wrapper: {args.tool}")
    payload = json.loads(args.arguments)
    if not isinstance(payload, dict):
        raise ValueError("tool arguments must be a JSON object")
    payload["project"] = args.project
    result = run_binary(["cli", args.tool, json.dumps(payload, ensure_ascii=False)], timeout=args.timeout)
    sys.stderr.write(result.stderr)
    sys.stdout.write(result.stdout)
    return result.returncode


def main() -> int:
    parser = argparse.ArgumentParser(description="Scoped Codebase Memory integration for AI Docs Hub.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    status = subparsers.add_parser("status", help="Check binary, ignore policy, and one project graph.")
    status.add_argument("--project", required=True)
    status.add_argument("--timeout", type=float, default=8.0)
    status.set_defaults(handler=command_status)

    index = subparsers.add_parser("index", help="Index a configured project without repository persistence.")
    index.add_argument("--project", required=True)
    index.add_argument("--mode", choices=("fast", "moderate", "full"), default="moderate")
    index.add_argument("--timeout", type=float, default=900.0)
    index.set_defaults(handler=command_index)

    configure = subparsers.add_parser(
        "configure",
        help="Install project-scoped Codex MCP config and managed AGENTS.md routing rules.",
    )
    configure.add_argument("--project", required=True)
    configure.set_defaults(handler=command_configure)

    tool = subparsers.add_parser("tool", help="Run a read-oriented Codebase Memory CLI tool.")
    tool.add_argument("--project", required=True)
    tool.add_argument("--tool", required=True)
    tool.add_argument("--arguments", default="{}")
    tool.add_argument("--timeout", type=float, default=30.0)
    tool.set_defaults(handler=command_tool)

    args = parser.parse_args()
    try:
        return int(args.handler(args))
    except (FileNotFoundError, ValueError, json.JSONDecodeError, subprocess.TimeoutExpired) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
