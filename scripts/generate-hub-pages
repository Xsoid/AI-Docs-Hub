#!/usr/bin/env python3.11
"""Render canonical Hub Markdown from docs/ into Starlight content pages."""
from __future__ import annotations

import json
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DOCS = ROOT / "docs"
SITE = ROOT / "docs-site" / "src" / "content" / "docs"
MARKER = "<!-- Generated by scripts/generate-hub-pages. Do not edit manually. -->"


def sources() -> dict[Path, Path]:
    pages: dict[Path, Path] = {DOCS / "architecture" / "overview.md": SITE / "hub" / "architecture.md"}
    for source in (DOCS / "operations").glob("*.md"):
        pages[source] = SITE / "hub" / source.name
    for source in (DOCS / "standards").glob("*.md"):
        pages[source] = SITE / "standards" / source.name
    return dict(sorted(pages.items()))


def metadata_and_body(source: Path) -> tuple[str, str]:
    raw = source.read_text(encoding="utf-8").strip()
    match = re.match(r"^#\s+(.+?)\s*$", raw, flags=re.MULTILINE)
    if not match:
        raise ValueError(f"canonical document requires one H1: {source.relative_to(ROOT)}")
    title = match.group(1).strip()
    body = raw[: match.start()] + raw[match.end() :]
    return title, body.strip()


def route(output: Path) -> str:
    relative = output.relative_to(SITE).with_suffix("")
    return "/" + relative.as_posix() + "/"


def rewrite_links(body: str, source: Path, mapping: dict[Path, Path]) -> str:
    routes = {candidate.resolve(): route(output) for candidate, output in mapping.items()}

    def replace(match: re.Match[str]) -> str:
        label, href = match.group(1), match.group(2)
        if "://" in href or href.startswith(("#", "/", "mailto:")):
            return match.group(0)
        target, separator, fragment = href.partition("#")
        candidate = (source.parent / target).resolve()
        destination = routes.get(candidate)
        if not destination:
            return match.group(0)
        return f"[{label}]({destination}{separator}{fragment})"

    return re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)", replace, body)


def render(source: Path, mapping: dict[Path, Path]) -> str:
    title, body = metadata_and_body(source)
    return "\n".join(("---", f"title: {json.dumps(title, ensure_ascii=False)}", "---", "", MARKER, "", rewrite_links(body, source, mapping), ""))


def main() -> int:
    mapping = sources()
    written: list[str] = []
    for source, output in mapping.items():
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(render(source, mapping), encoding="utf-8")
        written.append(output.relative_to(ROOT).as_posix())
    print(json.dumps({"written": written}, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
