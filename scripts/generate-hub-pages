#!/usr/bin/env python3.11
"""Render canonical Hub Markdown from docs/ into Starlight content pages."""
from __future__ import annotations

import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
DOCS = ROOT / "docs"
SITE = ROOT / "docs-site" / "src" / "content" / "docs"
MARKER = "<!-- Generated by scripts/generate-hub-pages. Do not edit manually. -->"
MANAGED_DIRECTORIES = (SITE / "hub", SITE / "standards")


def sources() -> dict[Path, Path]:
    pages: dict[Path, Path] = {DOCS / "architecture" / "overview.md": SITE / "hub" / "architecture.md"}
    for source in (DOCS / "operations").glob("*.md"):
        pages[source] = SITE / "hub" / source.name
    for source in (DOCS / "standards").glob("*.md"):
        pages[source] = SITE / "standards" / source.name
    return dict(sorted(pages.items()))


def metadata_and_body(source: Path) -> tuple[str, str]:
    raw = source.read_text(encoding="utf-8").strip()
    match = re.match(r"^#\s+(.+?)\s*$", raw, flags=re.MULTILINE)
    if not match:
        raise ValueError(f"canonical document requires one H1: {source.relative_to(ROOT)}")
    title = match.group(1).strip()
    body = raw[: match.start()] + raw[match.end() :]
    return title, body.strip()


def route(output: Path) -> str:
    relative = output.relative_to(SITE).with_suffix("")
    return "/" + relative.as_posix() + "/"


def rewrite_links(body: str, source: Path, mapping: dict[Path, Path]) -> str:
    routes = {candidate.resolve(): route(output) for candidate, output in mapping.items()}

    def replace(match: re.Match[str]) -> str:
        label, href = match.group(1), match.group(2)
        if "://" in href or href.startswith(("#", "/", "mailto:")):
            return match.group(0)
        target, separator, fragment = href.partition("#")
        candidate = (source.parent / target).resolve()
        destination = routes.get(candidate)
        if not destination:
            return match.group(0)
        return f"[{label}]({destination}{separator}{fragment})"

    return re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)", replace, body)


def render(source: Path, mapping: dict[Path, Path]) -> str:
    title, body = metadata_and_body(source)
    return "\n".join(("---", f"title: {json.dumps(title, ensure_ascii=False)}", "---", "", MARKER, "", rewrite_links(body, source, mapping), ""))


def validate_mapping(mapping: dict[Path, Path]) -> None:
    outputs: dict[Path, Path] = {}
    for source, output in mapping.items():
        resolved = output.resolve()
        previous = outputs.get(resolved)
        if previous is not None:
            raise ValueError(
                "generated output collision: "
                f"{previous.relative_to(ROOT)} and {source.relative_to(ROOT)} -> {output.relative_to(ROOT)}"
            )
        outputs[resolved] = source
        if not any(resolved.is_relative_to(directory.resolve()) for directory in MANAGED_DIRECTORIES):
            raise ValueError(f"generated output outside managed directories: {output.relative_to(ROOT)}")


def stale_outputs(mapping: dict[Path, Path]) -> list[Path]:
    expected = {output.resolve() for output in mapping.values()}
    stale: list[Path] = []
    for directory in MANAGED_DIRECTORIES:
        if not directory.exists():
            continue
        for candidate in directory.rglob("*.md"):
            if candidate.resolve() not in expected and MARKER in candidate.read_text(encoding="utf-8"):
                stale.append(candidate)
    return sorted(stale)


def generate(*, check: bool = False) -> dict[str, list[str]]:
    mapping = sources()
    validate_mapping(mapping)
    written: list[str] = []
    for source, output in mapping.items():
        expected = render(source, mapping)
        if output.exists() and MARKER not in output.read_text(encoding="utf-8"):
            raise ValueError(f"refusing to overwrite non-generated page: {output.relative_to(ROOT)}")
        if check:
            if not output.exists() or output.read_text(encoding="utf-8") != expected:
                raise ValueError(f"generated page is missing or stale: {output.relative_to(ROOT)}")
        else:
            output.parent.mkdir(parents=True, exist_ok=True)
            output.write_text(expected, encoding="utf-8")
        written.append(output.relative_to(ROOT).as_posix())
    stale = stale_outputs(mapping)
    if check and stale:
        raise ValueError("obsolete generated pages: " + ", ".join(path.relative_to(ROOT).as_posix() for path in stale))
    if not check:
        for output in stale:
            output.unlink()
    return {
        "written": written,
        "removed": [output.relative_to(ROOT).as_posix() for output in stale],
    }


def main() -> int:
    check = sys.argv[1:] == ["--check"]
    if not check and sys.argv[1:]:
        raise SystemExit("usage: generate-hub-pages [--check]")
    try:
        result = generate(check=check)
    except ValueError as error:
        print(json.dumps({"status": "error", "error": str(error)}, ensure_ascii=False), file=sys.stderr)
        return 1
    print(json.dumps(result, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
