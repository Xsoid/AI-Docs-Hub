#!/usr/bin/env sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
export ASTRO_TELEMETRY_DISABLED="${ASTRO_TELEMETRY_DISABLED:-1}"
export npm_config_cache="${npm_config_cache:-$ROOT_DIR/.npm-cache}"

if command -v npm >/dev/null 2>&1; then
  cd "$ROOT_DIR/docs-site"
  exec npm "$@"
fi

echo "npm is not installed. Install local Node.js 22 LTS with npm before running docs commands." >&2
exit 127
