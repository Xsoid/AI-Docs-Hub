#!/usr/bin/env python3.11
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from rag.config import get_project_config, load_project_configs  # noqa: E402
from rag.lite import check_project_secrets  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Scan configured project files before indexing.")
    parser.add_argument("--project", help="Project name from configs/projects")
    parser.add_argument("--all", action="store_true", help="Scan all projects")
    args = parser.parse_args()

    projects = []
    if args.all:
        projects = list(load_project_configs().values())
    elif args.project:
        projects = [get_project_config(args.project)]
    else:
        parser.error("Use --project NAME or --all")

    reports = []
    exit_code = 0
    for config in projects:
        try:
            report = check_project_secrets(config)
            if report["blocked_count"]:
                exit_code = 2
            reports.append(report)
        except Exception as exc:  # noqa: BLE001
            exit_code = 1
            reports.append({"project": config.project, "error": str(exc)})

    print(json.dumps({"reports": reports}, ensure_ascii=False, indent=2))
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
