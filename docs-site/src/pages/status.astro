---
const title = 'Статус AI Docs Hub';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f7f7f4;
        --surface: #ffffff;
        --surface-2: #f0f3f4;
        --text: #1f2528;
        --muted: #667076;
        --line: #d9dddc;
        --green: #16845a;
        --green-bg: #e8f5ee;
        --red: #b9332a;
        --red-bg: #faeae8;
        --amber: #9a6500;
        --amber-bg: #fff3d6;
        --blue: #245c9d;
        --blue-bg: #e8f0fa;
        --shadow: 0 18px 50px rgba(31, 37, 40, 0.08);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-width: 320px;
        min-height: 100vh;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.74), rgba(247, 247, 244, 0) 240px),
          var(--bg);
        color: var(--text);
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        letter-spacing: 0;
      }

      a {
        color: inherit;
      }

      .shell {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
        padding: 24px 0 40px;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 56px;
        margin-bottom: 20px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
      }

      .mark {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface);
        box-shadow: 0 10px 30px rgba(31, 37, 40, 0.06);
        color: var(--blue);
        font-weight: 800;
      }

      .brand h1 {
        margin: 0;
        font-size: 20px;
        line-height: 1.15;
      }

      .brand p {
        margin: 3px 0 0;
        color: var(--muted);
        font-size: 13px;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .button,
      .link-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        padding: 0 13px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface);
        color: var(--text);
        font: inherit;
        font-size: 14px;
        text-decoration: none;
        cursor: pointer;
      }

      .button:hover,
      .link-button:hover {
        border-color: #b8c0c0;
        background: #fbfbfa;
      }

      .button:disabled {
        opacity: 0.68;
        cursor: progress;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
        gap: 18px;
        align-items: stretch;
        margin-bottom: 18px;
      }

      .summary {
        position: relative;
        overflow: hidden;
        min-height: 250px;
        padding: 28px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .summary::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 8px;
        background: var(--blue);
      }

      .summary[data-state="up"]::before {
        background: var(--green);
      }

      .summary[data-state="down"]::before {
        background: var(--red);
      }

      .summary[data-state="degraded"]::before {
        background: var(--amber);
      }

      .state-line {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        color: var(--muted);
        font-size: 14px;
      }

      .state-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--blue);
        box-shadow: 0 0 0 5px var(--blue-bg);
      }

      .summary[data-state="up"] .state-dot {
        background: var(--green);
        box-shadow: 0 0 0 5px var(--green-bg);
      }

      .summary[data-state="down"] .state-dot {
        background: var(--red);
        box-shadow: 0 0 0 5px var(--red-bg);
      }

      .summary[data-state="degraded"] .state-dot {
        background: var(--amber);
        box-shadow: 0 0 0 5px var(--amber-bg);
      }

      .summary h2 {
        margin: 0;
        font-size: clamp(32px, 5vw, 56px);
        line-height: 1.02;
        letter-spacing: 0;
      }

      .summary-text {
        max-width: 700px;
        margin: 18px 0 0;
        color: var(--muted);
        font-size: 18px;
        line-height: 1.55;
      }

      .meta-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-top: 28px;
      }

      .meta {
        min-height: 72px;
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface-2);
      }

      .meta span {
        display: block;
        color: var(--muted);
        font-size: 12px;
      }

      .meta strong {
        display: block;
        margin-top: 5px;
        font-size: 16px;
        overflow-wrap: anywhere;
      }

      .actions {
        padding: 22px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .actions h2,
      .section h2 {
        margin: 0 0 14px;
        font-size: 18px;
      }

      .action-list {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .action-list li {
        min-height: 44px;
        padding: 12px 12px 12px 14px;
        border-left: 4px solid var(--blue);
        border-radius: 8px;
        background: var(--blue-bg);
        color: #203044;
        font-size: 14px;
        line-height: 1.45;
      }

      .action-list li[data-kind="ok"] {
        border-color: var(--green);
        background: var(--green-bg);
      }

      .operation-panel {
        display: none;
        gap: 9px;
        margin-top: 16px;
        padding: 14px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface-2);
      }

      .operation-panel[data-visible="true"] { display: grid; }
      .operation-panel[data-state="ok"] { border-color: #9ed6bd; background: var(--green-bg); }
      .operation-panel[data-state="error"] { border-color: #e4aaa5; background: var(--red-bg); }

      .operation-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 13px;
        font-weight: 800;
      }

      .operation-message,
      .operation-meta {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.4;
        overflow-wrap: anywhere;
      }

      .operation-progress {
        overflow: hidden;
        height: 8px;
        border-radius: 999px;
        background: rgba(102, 112, 118, 0.18);
      }

      .operation-progress span {
        display: block;
        width: 12%;
        height: 100%;
        border-radius: inherit;
        background: var(--blue);
        transition: width 240ms ease;
      }

      .operation-panel[data-state="running"] .operation-progress span {
        animation: operation-pulse 1.2s ease-in-out infinite alternate;
      }

      .operation-panel[data-state="ok"] .operation-progress span { width: 100%; background: var(--green); }
      .operation-panel[data-state="error"] .operation-progress span { width: 100%; background: var(--red); }

      @keyframes operation-pulse {
        from { width: 24%; }
        to { width: 78%; }
      }

      .command-box {
        margin-top: 16px;
        display: grid;
        gap: 8px;
      }

      .command {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        min-height: 42px;
        padding: 10px 12px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fbfbfa;
      }

      .command code {
        color: #273036;
        font-size: 13px;
        overflow-wrap: anywhere;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .section {
        margin-top: 18px;
      }

      .component {
        min-height: 155px;
        padding: 18px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface);
      }

      .component-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 14px;
      }

      .component h3 {
        margin: 0;
        font-size: 17px;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 80px;
        min-height: 28px;
        padding: 0 10px;
        border-radius: 999px;
        background: var(--blue-bg);
        color: var(--blue);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .pill[data-status="ok"] {
        background: var(--green-bg);
        color: var(--green);
      }

      .pill[data-status="down"],
      .pill[data-status="error"] {
        background: var(--red-bg);
        color: var(--red);
      }

      .pill[data-status="warning"] {
        background: var(--amber-bg);
        color: var(--amber);
      }

      .component p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.45;
        overflow-wrap: anywhere;
      }

      .component .plain {
        margin-top: 12px;
        color: var(--text);
      }

      .detail-list {
        display: grid;
        gap: 8px;
        margin: 14px 0 0;
        padding: 0;
        list-style: none;
      }

      .detail-row {
        display: grid;
        gap: 5px;
        padding: 10px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fbfbfa;
      }

      .detail-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        min-width: 0;
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
      }

      .detail-title span:first-child {
        overflow-wrap: anywhere;
      }

      .tag {
        flex: 0 0 auto;
        padding: 3px 7px;
        border-radius: 999px;
        background: var(--surface-2);
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .tag[data-kind="ok"] {
        background: var(--green-bg);
        color: var(--green);
      }

      .tag[data-kind="warning"] {
        background: var(--amber-bg);
        color: var(--amber);
      }

      .tag[data-kind="error"],
      .tag[data-kind="down"] {
        background: var(--red-bg);
        color: var(--red);
      }

      .tag[data-kind="info"] {
        background: var(--blue-bg);
        color: var(--blue);
      }

      .detail-meta {
        color: var(--muted);
        font-size: 12px;
        line-height: 1.4;
        overflow-wrap: anywhere;
      }

      .fix-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
      }

      .fix-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 0 10px;
        border: 1px solid #b8c0c0;
        border-radius: 8px;
        background: var(--surface);
        color: var(--text);
        font: inherit;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
      }

      .fix-button:hover {
        border-color: #8f9b9b;
        background: #fbfbfa;
      }

      .fix-button:disabled {
        opacity: 0.68;
        cursor: progress;
      }

      .fix-button[aria-busy="true"]::before {
        content: "";
        width: 12px;
        height: 12px;
        margin-right: 6px;
        border: 2px solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        animation: button-spin 0.8s linear infinite;
      }

      @keyframes button-spin {
        to { transform: rotate(360deg); }
      }

      .footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-top: 22px;
        color: var(--muted);
        font-size: 13px;
      }

      .error {
        display: none;
        margin-top: 14px;
        padding: 12px 14px;
        border: 1px solid #efc7c3;
        border-radius: 8px;
        background: var(--red-bg);
        color: var(--red);
      }

      body[data-error="true"] .error {
        display: block;
      }

      @media (max-width: 920px) {
        .hero,
        .grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .shell {
          width: min(100% - 20px, 1180px);
          padding-top: 14px;
        }

        .topbar,
        .footer {
          align-items: stretch;
          flex-direction: column;
        }

        .nav {
          justify-content: stretch;
        }

        .button,
        .link-button {
          width: 100%;
        }

        .summary {
          padding: 22px 18px 20px 24px;
        }

        .summary-text {
          font-size: 16px;
        }

        .meta-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <div class="brand">
          <div class="mark" aria-hidden="true">AI</div>
          <div>
            <h1>AI Docs Hub</h1>
            <p>Локальный пульт состояния</p>
          </div>
        </div>
        <nav class="nav" aria-label="Навигация">
          <button class="button" id="refresh" type="button">Обновить</button>
          <a class="link-button" href="/">Документация</a>
        </nav>
      </header>

      <section class="hero" aria-label="Главное состояние">
        <div class="summary" id="summary" data-state="loading">
          <div class="state-line">
            <span class="state-dot" aria-hidden="true"></span>
            <span id="stateLabel">Проверяю</span>
          </div>
          <h2 id="headline">Смотрю, что происходит</h2>
          <p class="summary-text" id="summaryText">Страница получает состояние локального хаба.</p>
          <div class="meta-grid">
            <div class="meta">
              <span>Последняя проверка</span>
              <strong id="checkedAt">-</strong>
            </div>
            <div class="meta">
              <span>Адрес сайта</span>
              <strong>localhost:4321</strong>
            </div>
          </div>
          <div class="error" id="errorBox"></div>
        </div>

        <aside class="actions" aria-label="Что сделать">
          <h2>Что сделать</h2>
          <ul class="action-list" id="actions">
            <li>Проверяю состояние.</li>
          </ul>
          <div class="operation-panel" id="operationPanel" data-visible="false" data-state="idle" aria-live="polite">
            <div class="operation-head">
              <span id="operationTitle">Операция</span>
              <span id="operationState">Ожидание</span>
            </div>
            <p class="operation-message" id="operationMessage">Операция еще не запускалась.</p>
            <div class="operation-progress" aria-hidden="true"><span id="operationProgress"></span></div>
            <p class="operation-meta" id="operationMeta"></p>
          </div>
          <div class="command-box" aria-label="Основные команды">
            <div class="command"><code>make hub-status</code></div>
            <div class="command"><code>make hub-logs</code></div>
            <div class="command"><code>make hub-restart</code></div>
          </div>
        </aside>
      </section>

      <section class="section" aria-label="Компоненты">
        <h2>Что проверено</h2>
        <div class="grid" id="components"></div>
      </section>

      <footer class="footer">
        <span>Страница обновляется автоматически каждые 5 секунд.</span>
        <span id="apiPath">Источник: /api/hub-status.json</span>
      </footer>
    </main>

    <script is:inline>
      const componentCopy = {
        runtime: {
          title: 'Пульт управления',
          description: 'Следит, запущен ли хаб вручную или через автозапуск macOS.'
        },
        'docs-site': {
          title: 'Веб-страница',
          description: 'Отвечает за этот сайт и адрес localhost:4321.'
        },
        repository: {
          title: 'Настройки',
          description: 'Проверяет файлы хаба, конфиги проектов и локальные зависимости.'
        },
        projects: {
          title: 'Проекты',
          description: 'Показывает подключенные проекты, source discovery и project-scoped правила.'
        },
        generated: {
          title: 'Generated context',
          description: 'Проверяет derived project pages и llms*.txt.'
        },
        rag: {
          title: 'Поиск по документам',
          description: 'Показывает backend, свежесть индексов, source-файлы, документы и чанки.'
        },
        mkdocs: {
          title: 'MkDocs',
          description: 'Показывает, какие проекты используют MkDocs как источник структуры документации.'
        },
        'docs-readiness': {
          title: 'Документация',
          description: 'Показывает покрытие recommended docs и доступность scaffold по проектам.'
        },
        mcp: {
          title: 'Связь с Codex',
          description: 'Проверяет локальный MCP-мост и список доступных tools.'
        },
        'codebase-memory': {
          title: 'Граф исходного кода',
          description: 'Показывает локальный Codebase Memory, его версию и project-scoped графы кода.'
        },
        watcher: {
          title: 'Автообновление',
          description: 'Следит за изменениями в подключенных проектах.'
        }
      };

      const statusText = {
        ok: 'Работает',
        down: 'Лежит',
        error: 'Ошибка',
        warning: 'Внимание'
      };

      const summaryText = {
        up: {
          label: 'Все в порядке',
          headline: 'Хаб работает',
          text: 'Документация открывается, поиск и связь с Codex отвечают, автообновление активно.'
        },
        down: {
          label: 'Есть авария',
          headline: 'Хаб лежит',
          text: 'Один из обязательных узлов не отвечает. Ниже указано, что именно сломалось и какую команду выполнить.'
        },
        degraded: {
          label: 'Работает не полностью',
          headline: 'Хаб требует внимания',
          text: 'Основные части живы, но один из дополнительных признаков здоровья отсутствует или устарел.'
        },
        loading: {
          label: 'Проверяю',
          headline: 'Смотрю, что происходит',
          text: 'Страница получает состояние локального хаба.'
        }
      };

      const astroScopeClass =
        Array.from(document.querySelector('.shell')?.classList || []).find((className) =>
          className.startsWith('astro-')
        ) || '';

      function applyAstroScope(element) {
        if (astroScopeClass) element.classList.add(astroScopeClass);
        return element;
      }

      function scopedElement(tagName, className) {
        const element = document.createElement(tagName);
        if (className) element.className = className;
        return applyAstroScope(element);
      }

      function formatTime(value) {
        if (!value) return '-';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return value;
        return new Intl.DateTimeFormat('ru-RU', {
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          day: '2-digit',
          month: '2-digit'
        }).format(date);
      }

      function translateStep(step) {
        const map = [
          ['start foreground runtime: make hub-dev', 'Запустить вручную: make hub-dev'],
          [
            'install persistent runtime: make hub-install && make hub-start',
            'Включить автозапуск: make hub-install && make hub-start'
          ],
          ['inspect docs-site through runtime logs: make hub-logs', 'Посмотреть логи: make hub-logs'],
          ['watcher heartbeat is produced by make hub-dev', 'Автообновление появляется после запуска hub-dev'],
          ['inspect MCP startup: make mcp-test', 'Проверить связь с Codex: make mcp-test'],
          ['inspect repository health: make healthcheck', 'Проверить настройки: make healthcheck']
        ];
        const found = map.find(([source]) => source === step);
        return found ? found[1] : step;
      }

      function setSummary(status) {
        const safeStatus = summaryText[status] ? status : 'loading';
        const copy = summaryText[safeStatus];
        document.getElementById('summary').dataset.state = safeStatus;
        document.getElementById('stateLabel').textContent = copy.label;
        document.getElementById('headline').textContent = copy.headline;
        document.getElementById('summaryText').textContent = copy.text;
      }

      function componentCard(name, component) {
        const copy = componentCopy[name] || { title: name, description: 'Локальная проверка хаба.' };
        const status = component.status || 'warning';
        const article = scopedElement('article', 'component');
        article.innerHTML = `
          <div class="component-head">
            <h3></h3>
            <span class="pill" data-status="${status}"></span>
          </div>
          <p></p>
          <p class="plain"></p>
        `;
        article.querySelectorAll('*').forEach(applyAstroScope);
        article.querySelector('h3').textContent = copy.title;
        article.querySelector('.pill').textContent = statusText[status] || status;
        const paragraphs = article.querySelectorAll('p');
        paragraphs[0].textContent = copy.description;
        paragraphs[1].textContent = component.message || 'Нет сообщения.';
        appendComponentDetails(name, article, component.details || {});
        appendComponentFixes(name, article, component);
        return article;
      }

      function appendComponentDetails(name, article, details) {
        if (name === 'projects') {
          appendProjectRows(article, details.projects, projectConfigBadge, projectConfigMeta, projectConnectionFixes);
        } else if (name === 'generated') {
          appendProjectRows(article, details.projects, generatedBadge, generatedMeta);
        } else if (name === 'rag') {
          appendProjectRows(article, details.projects, ragBadge, ragMeta, ragProjectFixes);
        } else if (name === 'mkdocs') {
          appendProjectRows(article, details.projects, mkdocsBadge, mkdocsMeta);
        } else if (name === 'docs-readiness') {
          appendProjectRows(article, details.projects, docsReadinessBadge, docsReadinessMeta);
        } else if (name === 'codebase-memory') {
          appendProjectRows(article, details.projects, codebaseMemoryBadge, codebaseMemoryMeta);
        }
      }

      function codebaseMemoryBadge(project) {
        if (project.status === 'indexed') return { text: 'indexed', kind: 'ok' };
        return { text: project.status || 'unknown', kind: 'warning' };
      }

      function codebaseMemoryMeta(project) {
        return [
          `nodes: ${project.nodes ?? 0}`,
          `edges: ${project.edges ?? 0}`,
          project.root ? `root: ${project.root}` : ''
        ];
      }

      function mkdocsBadge(project) {
        if (project.enabled) return { text: 'активен', kind: 'ok' };
        if (project.backend === 'standard') return { text: 'standard', kind: 'neutral' };
        if (project.requested) return { text: 'ожидается', kind: 'warning' };
        return { text: 'не найден', kind: 'neutral' };
      }

      function mkdocsMeta(project) {
        const parts = [`backend: ${project.backend || 'unknown'}`];
        if (project.config_path) parts.push(`config: ${project.config_path}`);
        if (project.enabled && project.docs_dir) parts.push(`docs_dir: ${project.docs_dir}`);
        if (project.site_name) parts.push(`site: ${project.site_name}`);
        if (Array.isArray(project.warnings) && project.warnings.length) {
          parts.push(project.warnings[0]);
        }
        return parts;
      }

      function projectConfigBadge(project) {
        if (project.status === 'error') return { text: 'ошибка', kind: 'error' };
        if (project.status === 'warning') return { text: 'внимание', kind: 'warning' };
        if (!project.root_exists) return { text: 'нет root', kind: 'warning' };
        return { text: 'подключён', kind: 'ok' };
      }

      function projectConfigMeta(project) {
        const connections = Array.isArray(project.connections) ? project.connections : [];
        const connectionText = connections.map((item) =>
          `${item.label}: ${item.status === 'connected' ? 'подключён' : item.status === 'attention' ? 'требует внимания' : 'не подключён'}`
        );
        return [
          `namespace: ${project.namespace || project.project}`,
          `backend: ${project.docs_backend || 'unknown'}`,
          `include: ${project.effective_include_count ?? project.include_count ?? 0}`,
          `exclude: ${project.effective_exclude_count ?? 0}`,
          `agent rules: ${project.agent_rules_count ?? 0}`,
          project.recommendations_count ? `docs recommendations: ${project.recommendations_count}` : '',
          ...connectionText
        ];
      }

      function projectConnectionFixes(project) {
        const connections = Array.isArray(project.connections) ? project.connections : [];
        return connections
          .filter((item) => item.action)
          .map((item) => ({
            action: item.action,
            project: project.project,
            label: item.action_label || `Подключить ${item.label}`
          }));
      }

      function generatedBadge(project) {
        if (project.page_exists) return { text: 'page ok', kind: 'ok' };
        return { text: 'missing', kind: 'warning' };
      }

      function generatedMeta(project) {
        return [project.path ? `page: ${project.path}` : 'project page'];
      }

      function ragBadge(project) {
        if (project.stale || project.status === 'stale') return { text: 'stale', kind: 'warning' };
        if (project.status === 'security_skipped' || project.secret_blocked_count) {
          return { text: 'skipped', kind: 'warning' };
        }
        if (project.indexed) return { text: 'indexed', kind: 'ok' };
        if (project.status === 'error' || project.status === 'blocked') return { text: project.status, kind: 'error' };
        return { text: project.status || 'missing', kind: 'warning' };
      }

      function ragMeta(project) {
        const firstSecret = Array.isArray(project.secret_blocked) ? project.secret_blocked[0] : null;
        const firstFinding = Array.isArray(firstSecret?.findings) ? firstSecret.findings[0] : null;
        const firstSecretText = firstSecret
          ? `first skipped: ${firstSecret.source_path}${firstFinding?.line ? `:${firstFinding.line}` : ''}`
          : '';
        if (!project.indexed) {
          return [project.message || 'index is not available', project.index_path ? `index: ${project.index_path}` : ''];
        }
        return [
          `backend: ${project.backend || 'unknown'}`,
          `source files: ${project.source_files_count ?? 0}`,
          `docs: ${project.documents_count ?? 0}`,
          `chunks: ${project.chunks_count ?? 0}`,
          project.indexed_at ? `indexed: ${formatTime(project.indexed_at)}` : '',
          project.newest_source_mtime ? `newest source: ${formatTime(project.newest_source_mtime)}` : '',
          project.stale ? 'freshness: stale' : 'freshness: fresh',
          project.secret_blocked_count ? `secret scan skipped: ${project.secret_blocked_count}` : '',
          firstSecretText,
          project.index_path ? `index: ${project.index_path}` : '',
          project.next_step ? `next: ${project.next_step}` : ''
        ];
      }

      function ragProjectFixes(project) {
        if (project.status === 'blocked') return [];
        if (project.status === 'security_skipped' || project.secret_blocked_count) {
          return [{ action: 'rag.reindex', project: project.project, label: 'Актуализировать' }];
        }
        if (project.stale || project.status === 'stale') {
          return [{ action: 'rag.reindex', project: project.project, label: 'Переиндексировать' }];
        }
        if (!project.indexed && ['missing', 'error'].includes(project.status || '')) {
          return [{ action: 'rag.reindex', project: project.project, label: 'Собрать индекс' }];
        }
        if (project.indexed) {
          return [{ action: 'rag.reindex', project: project.project, label: 'Актуализировать' }];
        }
        return [];
      }

      function docsReadinessBadge(project) {
        const percent = Number(project.coverage_percent || 0);
        if (project.status === 'unknown') return { text: 'unknown', kind: 'warning' };
        if ((project.recommendations_count || 0) > 0) return { text: `${percent}%`, kind: 'warning' };
        return { text: `${percent}%`, kind: 'ok' };
      }

      function docsReadinessMeta(project) {
        return [
          `docs_dir: ${project.docs_dir || 'docs'}`,
          `core: ${project.core_percent ?? 0}%`,
          `technical: ${project.technical_percent ?? 0}%`,
          `recommendations: ${project.recommendations_count ?? 0}`,
          project.scaffold_available ? 'scaffold: available' : 'scaffold: unavailable'
        ];
      }

      function componentFixes(name, component) {
        if (name === 'docs-site' && component.status !== 'ok') {
          return [{ action: 'docs-site.restart', label: 'Перезапустить сайт' }];
        }
        if (name === 'runtime' && component.status !== 'ok') {
          const launchd = component.details?.launchd || {};
          if (launchd.installed) return [{ action: 'runtime.start', label: 'Запустить runtime' }];
          return [{ action: 'runtime.install-start', label: 'Установить и запустить' }];
        }
        return [];
      }

      function appendComponentFixes(name, article, component) {
        const fixes = componentFixes(name, component);
        if (!fixes.length) return;
        const wrap = scopedElement('div', 'fix-actions');
        for (const fix of fixes) {
          wrap.append(createFixButton(fix));
        }
        article.append(wrap);
      }

      function createFixButton(fix) {
        const button = scopedElement('button', 'fix-button');
        button.type = 'button';
        button.dataset.fixAction = fix.action;
        if (fix.project) button.dataset.fixProject = fix.project;
        button.textContent = fix.label;
        return button;
      }

      function appendProjectRows(article, rawProjects, badgeFor, metaFor, fixesFor) {
        const projects = Array.isArray(rawProjects) ? rawProjects : [];
        if (!projects.length) return;

        const list = scopedElement('ul', 'detail-list');
        for (const project of projects) {
          const badge = badgeFor(project);
          const row = scopedElement('li', 'detail-row');

          const title = scopedElement('div', 'detail-title');
          const name = scopedElement('span');
          name.textContent = project.project || 'project';
          const tag = scopedElement('span', 'tag');
          tag.dataset.kind = badge.kind;
          tag.textContent = badge.text;
          title.append(name, tag);

          const meta = scopedElement('div', 'detail-meta');
          const parts = metaFor(project).filter(Boolean);
          meta.textContent = parts.join(' · ');

          row.append(title, meta);
          const fixes = fixesFor ? fixesFor(project) : [];
          if (fixes.length) {
            const wrap = scopedElement('div', 'fix-actions');
            for (const fix of fixes) {
              wrap.append(createFixButton(fix));
            }
            row.append(wrap);
          }
          list.append(row);
        }
        article.append(list);
      }

      function setActions(payload) {
        const list = document.getElementById('actions');
        list.textContent = '';
        const status = payload.status;
        let actions = [];
        if (status === 'up') {
          actions = ['Все работает. Можно открывать документацию и работать с Codex.'];
        } else if (status === 'degraded') {
          actions = ['Хаб работает не полностью. Посмотрите строку с пометкой “Внимание” или “Лежит”.'];
        } else {
          actions = ['Запустите persistent runtime: make hub-install && make hub-start.'];
        }
        const next = Array.isArray(payload.next) ? payload.next.map(translateStep) : [];
        const full = [...actions, ...next];
        for (const item of full) {
          const li = scopedElement('li');
          li.textContent = item;
          if (status === 'up') li.dataset.kind = 'ok';
          list.append(li);
        }
      }

      function collectNextSteps(payload) {
        const components = payload.components || {};
        const steps = [];
        if (components.runtime?.status !== 'ok') {
          steps.push('start foreground runtime: make hub-dev');
          steps.push('install persistent runtime: make hub-install && make hub-start');
        }
        if (components['docs-site']?.status !== 'ok') {
          steps.push('inspect docs-site through runtime logs: make hub-logs');
        }
        if (components.mcp?.status !== 'ok') {
          steps.push('inspect MCP startup: make mcp-test');
        }
        if (components.repository?.status === 'error') {
          steps.push('inspect repository health: make healthcheck');
        }
        if (components.watcher?.status !== 'ok') {
          steps.push('watcher heartbeat is produced by make hub-dev');
        }
        payload.next = [...new Set(steps)];
      }

      function render(payload) {
        document.body.dataset.error = 'false';
        const status = payload.status || 'down';
        collectNextSteps(payload);
        setSummary(status);
        setActions(payload);
        document.getElementById('checkedAt').textContent = formatTime(payload.checked_at);

        const grid = document.getElementById('components');
        grid.textContent = '';
        const components = payload.components || {};
        for (const name of [
          'runtime',
          'docs-site',
          'repository',
          'projects',
          'generated',
          'rag',
          'mkdocs',
          'docs-readiness',
          'mcp',
          'codebase-memory',
          'watcher'
        ]) {
          grid.append(componentCard(name, components[name] || { status: 'warning', message: 'Нет данных.' }));
        }
      }

      const refreshButton = document.getElementById('refresh');
      const apiPath = document.getElementById('apiPath');
      const operationPanel = document.getElementById('operationPanel');
      const operationTitle = document.getElementById('operationTitle');
      const operationState = document.getElementById('operationState');
      const operationMessage = document.getElementById('operationMessage');
      const operationMeta = document.getElementById('operationMeta');
      const operationProgress = document.getElementById('operationProgress');
      const apiLabel = 'Источник: /api/hub-status.json';
      const fixApiBase = 'http://127.0.0.1:4322';
      let refreshInFlight = false;
      let fixInFlight = false;

      function setRefreshButton(active) {
        refreshButton.disabled = active;
        refreshButton.textContent = active ? 'Обновляю...' : 'Обновить';
        refreshButton.setAttribute('aria-busy', active ? 'true' : 'false');
      }

      async function refresh() {
        if (refreshInFlight) return;
        refreshInFlight = true;
        setRefreshButton(true);
        apiPath.textContent = 'Обновляю статус...';
        try {
          const response = await fetch(`/api/hub-status.json?ts=${Date.now()}`, { cache: 'no-store' });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const payload = await response.json();
          if (payload.error) throw new Error(payload.error);
          render(payload);
          apiPath.textContent = `${apiLabel}, получено ${formatTime(new Date().toISOString())}`;
        } catch (error) {
          document.body.dataset.error = 'true';
          setSummary('down');
          document.getElementById('errorBox').textContent =
            error instanceof Error ? error.message : 'Не удалось получить статус.';
          apiPath.textContent = `${apiLabel}, ошибка ${formatTime(new Date().toISOString())}`;
        } finally {
          refreshInFlight = false;
          setRefreshButton(false);
        }
      }

      function setFixButtonsDisabled(active) {
        document.querySelectorAll('button[data-fix-action]').forEach((button) => {
          button.disabled = active;
        });
      }

      function fixMessage(payload) {
        if (payload?.result?.message) return payload.result.message;
        if (payload?.error) return payload.error;
        if (payload?.job_id) return `job ${payload.job_id}`;
        return 'fix action';
      }

      function actionTitle(action) {
        const titles = {
          'codebase-memory.index': 'Подключение Code graph',
          'generated.refresh': 'Сборка generated context',
          'rag.reindex': 'Актуализация Docs RAG',
          'docs-site.restart': 'Перезапуск docs-site',
          'runtime.start': 'Запуск runtime',
          'runtime.install-start': 'Установка и запуск runtime'
        };
        return titles[action] || action;
      }

      function showOperation({ action, project, state, message, jobId = '', startedAt = Date.now() }) {
        const labels = {
          starting: 'Запуск',
          queued: 'В очереди',
          running: 'Выполняется',
          ok: 'Готово',
          error: 'Ошибка'
        };
        operationPanel.dataset.visible = 'true';
        operationPanel.dataset.state = state;
        operationTitle.textContent = `${actionTitle(action)}${project ? ` · ${project}` : ''}`;
        operationState.textContent = labels[state] || state;
        operationMessage.textContent = message;
        const elapsed = Math.max(0, Math.round((Date.now() - startedAt) / 1000));
        operationMeta.textContent = [jobId ? `job: ${jobId}` : '', `прошло: ${elapsed} сек.`]
          .filter(Boolean)
          .join(' · ');
        operationProgress.style.width = state === 'starting' ? '12%' : state === 'queued' ? '20%' : '';
      }

      async function pollFixJob(operation, attempt = 0) {
        const { jobId, action, project, startedAt } = operation;
        let response;
        let payload;
        try {
          response = await fetch(`${fixApiBase}/job?job_id=${encodeURIComponent(jobId)}`, {
            cache: 'no-store'
          });
          payload = await response.json();
        } catch (error) {
          if (attempt < 60) {
            apiPath.textContent = `Жду результат исправления: ${jobId}`;
            showOperation({ action, project, state: 'running', message: 'Fix server временно недоступен, повторяю проверку…', jobId, startedAt });
            await new Promise((resolve) => window.setTimeout(resolve, 2000));
            return pollFixJob(operation, attempt + 1);
          }
          throw error;
        }
        if (!response.ok && attempt < 60) {
          apiPath.textContent = `Жду результат исправления: ${jobId}`;
          showOperation({ action, project, state: 'running', message: `Fix server ответил HTTP ${response.status}; повторяю проверку…`, jobId, startedAt });
          await new Promise((resolve) => window.setTimeout(resolve, 2000));
          return pollFixJob(operation, attempt + 1);
        }
        if (['queued', 'running'].includes(payload.status) && attempt < 60) {
          apiPath.textContent = `Исправление выполняется: ${jobId}`;
          showOperation({
            action,
            project,
            state: payload.status === 'queued' ? 'queued' : 'running',
            message: payload.status === 'queued' ? 'Задача поставлена в очередь.' : 'Индексирование и проверка выполняются…',
            jobId,
            startedAt
          });
          await new Promise((resolve) => window.setTimeout(resolve, 2000));
          return pollFixJob(operation, attempt + 1);
        }
        if (payload.status === 'ok') {
          apiPath.textContent = `Исправление выполнено: ${fixMessage(payload)}`;
          showOperation({ action, project, state: 'ok', message: fixMessage(payload), jobId, startedAt });
          await refresh();
          return;
        }
        throw new Error(fixMessage(payload));
      }

      function showFixError(error, operation) {
        apiPath.textContent = `Ошибка исправления: ${error instanceof Error ? error.message : 'неизвестная ошибка'}`;
        showOperation({
          ...operation,
          state: 'error',
          message: error instanceof Error ? error.message : 'Неизвестная ошибка'
        });
        fixInFlight = false;
        setFixButtonsDisabled(false);
      }

      async function applyFix(button) {
        if (fixInFlight) return;
        fixInFlight = true;
        setFixButtonsDisabled(true);
        const originalText = button.textContent;
        const action = button.dataset.fixAction;
        const project = button.dataset.fixProject;
        const operation = { action, project, startedAt: Date.now() };
        button.textContent = 'Выполняется...';
        button.setAttribute('aria-busy', 'true');
        showOperation({ ...operation, state: 'starting', message: 'Отправляю команду локальному fix server…' });
        try {
          const params = new URLSearchParams({ action });
          if (project) params.set('project', project);
          const response = await fetch(`${fixApiBase}/apply-fix?${params.toString()}`, {
            cache: 'no-store'
          });
          const payload = await response.json();
          if (!response.ok || payload.status === 'error') throw new Error(fixMessage(payload));
          apiPath.textContent = `Исправление запущено: ${fixMessage(payload)}`;
          if (payload.job_id) {
            operation.jobId = payload.job_id;
            showOperation({ ...operation, state: 'queued', message: 'Задача принята и поставлена в очередь.' });
            await pollFixJob(operation);
          } else {
            showOperation({ ...operation, state: 'ok', message: fixMessage(payload) });
            await refresh();
          }
        } catch (error) {
          showFixError(error, operation);
        } finally {
          button.textContent = originalText;
          button.removeAttribute('aria-busy');
          fixInFlight = false;
          setFixButtonsDisabled(false);
        }
      }

      refreshButton.addEventListener('click', refresh);
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest('button[data-fix-action]');
        if (!(button instanceof HTMLButtonElement)) return;
        applyFix(button);
      });
      refresh();
      window.setInterval(() => {
        if (!fixInFlight) refresh();
      }, 5000);
    </script>
  </body>
</html>
