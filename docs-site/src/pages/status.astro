---
const title = 'AI Docs Hub — Control Center';
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <style is:global>
    :root { color-scheme:dark; --bg:#080b11; --surface:#111620; --raised:#171d29; --soft:#0d121a; --line:#252d3a; --line2:#354052; --text:#f4f7fb; --muted:#97a2b3; --green:#55dfa6; --green-bg:rgba(85,223,166,.11); --amber:#f5bd58; --amber-bg:rgba(245,189,88,.12); --red:#ff7f7f; --red-bg:rgba(255,127,127,.11); --blue:#7aabff; --blue-bg:rgba(122,171,255,.12); }
    * { box-sizing:border-box; } html { scroll-behavior:smooth; }
    body { margin:0; min-width:320px; min-height:100vh; background:radial-gradient(circle at 9% -4%,rgba(90,112,255,.16),transparent 34rem),radial-gradient(circle at 90% 12%,rgba(85,223,166,.08),transparent 30rem),var(--bg); color:var(--text); font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    button,input,select,textarea { font:inherit; } button,a { -webkit-tap-highlight-color:transparent; }
    .shell { width:min(1440px,calc(100% - 44px)); margin:auto; padding:24px 0 52px; }
    .topbar { display:flex; align-items:center; justify-content:space-between; gap:18px; margin-bottom:22px; }
    .brand { display:flex; align-items:center; gap:12px; min-width:0; } .mark { display:grid; place-items:center; width:42px; height:42px; border:1px solid #52617a; border-radius:13px; background:linear-gradient(145deg,#25324a,#10151f); color:#dce8ff; font-size:13px; font-weight:900; letter-spacing:.08em; }
    .brand h1 { margin:0; font-size:19px; } .brand p { margin:3px 0 0; color:var(--muted); font-size:12px; }
    .nav { display:flex; gap:8px; }
    .button,.link-button,.action-button { display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:40px; padding:0 14px; border:1px solid var(--line2); border-radius:11px; background:var(--raised); color:var(--text); text-decoration:none; cursor:pointer; transition:150ms ease; }
    .button:hover,.link-button:hover,.action-button:hover { border-color:#56647a; background:#1d2532; transform:translateY(-1px); } button:disabled { opacity:.55; cursor:progress; transform:none!important; }
    .button.primary,.action-button.primary { border-color:#647db5; background:#263a66; }
    .hero { position:relative; overflow:hidden; display:grid; grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr); gap:20px; padding:clamp(24px,4vw,46px); border:1px solid var(--line); border-radius:24px; background:linear-gradient(120deg,rgba(32,43,64,.92),rgba(14,19,28,.96)); box-shadow:0 24px 70px rgba(0,0,0,.25); }
    .hero::after { content:""; position:absolute; width:380px; height:380px; right:-160px; top:-220px; border-radius:50%; background:rgba(122,171,255,.1); }
    .hero-main,.hero-side { position:relative; z-index:1; } .eyebrow { display:flex; align-items:center; gap:9px; color:#b7c2d2; font-size:12px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
    .state-dot { width:9px; height:9px; border-radius:50%; background:var(--blue); box-shadow:0 0 0 5px var(--blue-bg); } .hero[data-state=up] .state-dot { background:var(--green); box-shadow:0 0 0 5px var(--green-bg); } .hero[data-state=degraded] .state-dot { background:var(--amber); box-shadow:0 0 0 5px var(--amber-bg); } .hero[data-state=down] .state-dot { background:var(--red); box-shadow:0 0 0 5px var(--red-bg); }
    .hero h2 { max-width:780px; margin:22px 0 12px; font-size:clamp(34px,5vw,68px); line-height:.98; letter-spacing:-.045em; } .hero-copy { max-width:720px; margin:0; color:#b3bdcb; font-size:clamp(15px,1.5vw,18px); line-height:1.6; }
    .hero-meta { display:flex; flex-wrap:wrap; gap:8px; margin-top:28px; } .meta-chip { padding:8px 11px; border:1px solid rgba(255,255,255,.09); border-radius:999px; background:rgba(5,8,13,.28); color:#b6c0cf; font-size:12px; }
    .hero-side { display:grid; align-content:start; gap:10px; } .hero-side h3 { margin:0 0 4px; color:#c7d0dd; font-size:13px; text-transform:uppercase; letter-spacing:.08em; } .next-step { padding:13px 14px; border:1px solid rgba(255,255,255,.08); border-radius:13px; background:rgba(5,8,13,.3); color:#d4dbe5; font-size:13px; line-height:1.45; } .next-step[data-kind=ok] { border-color:rgba(85,223,166,.24); background:rgba(85,223,166,.07); }
    .error-box { display:none; margin-top:12px; padding:12px; border:1px solid rgba(255,127,127,.4); border-radius:11px; background:var(--red-bg); color:var(--red); } body[data-error=true] .error-box { display:block; }
    .operation-panel { display:none; margin-top:16px; padding:15px; border:1px solid var(--line); border-radius:14px; background:var(--soft); } .operation-panel[data-visible=true] { display:grid; gap:8px; } .operation-head { display:flex; justify-content:space-between; gap:10px; font-size:13px; font-weight:800; } .operation-message,.operation-meta { margin:0; color:var(--muted); font-size:12px; line-height:1.45; overflow-wrap:anywhere; } .operation-progress { overflow:hidden; height:6px; border-radius:999px; background:#252d3a; } .operation-progress span { display:block; width:14%; height:100%; border-radius:inherit; background:var(--blue); } .operation-panel[data-state=running] .operation-progress span { animation:progress 1.2s ease-in-out infinite alternate; } .operation-panel[data-state=ok] .operation-progress span { width:100%; background:var(--green); } .operation-panel[data-state=error] .operation-progress span { width:100%; background:var(--red); } @keyframes progress { from{width:22%} to{width:80%} }
    .section { margin-top:32px; } .section-heading { display:flex; align-items:end; justify-content:space-between; gap:18px; margin-bottom:14px; } .section-heading h2 { margin:0; font-size:23px; letter-spacing:-.025em; } .section-heading p { max-width:760px; margin:5px 0 0; color:var(--muted); font-size:13px; line-height:1.5; } .section-count { color:var(--muted); font-size:12px; white-space:nowrap; }
    .system-grid { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:11px; } .system-card { min-height:150px; padding:16px; border:1px solid var(--line); border-radius:16px; background:rgba(17,22,32,.82); } .card-top { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; } .system-icon { display:grid; place-items:center; width:34px; height:34px; border:1px solid var(--line2); border-radius:10px; background:#171f2b; color:var(--blue); font-size:13px; font-weight:900; }
    .status-pill { display:inline-flex; align-items:center; min-height:24px; padding:0 8px; border-radius:999px; background:var(--blue-bg); color:var(--blue); font-size:10px; font-weight:900; letter-spacing:.05em; text-transform:uppercase; } .status-pill[data-state=ok],.status-pill[data-state=connected] { background:var(--green-bg); color:var(--green); } .status-pill[data-state=warning],.status-pill[data-state=attention],.status-pill[data-state=stale],.status-pill[data-state=missing] { background:var(--amber-bg); color:var(--amber); } .status-pill[data-state=error],.status-pill[data-state=down],.status-pill[data-state=blocked] { background:var(--red-bg); color:var(--red); }
    .system-card h3 { margin:17px 0 6px; font-size:15px; } .system-card p { margin:0; color:var(--muted); font-size:12px; line-height:1.5; overflow-wrap:anywhere; } .system-card .action-button { min-height:32px; margin-top:12px; padding:0 10px; font-size:11px; }
    .projects { display:grid; gap:16px; } .project-card { overflow:hidden; border:1px solid var(--line); border-radius:20px; background:rgba(17,22,32,.92); box-shadow:0 14px 45px rgba(0,0,0,.16); } .project-header { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:18px; padding:22px 22px 18px; border-bottom:1px solid var(--line); } .project-identity { display:flex; gap:14px; min-width:0; } .project-avatar { display:grid; place-items:center; flex:0 0 auto; width:48px; height:48px; border-radius:14px; background:linear-gradient(145deg,#263a66,#192238); color:#dce8ff; font-weight:900; } .project-title { min-width:0; } .project-title h3 { margin:1px 0 4px; font-size:21px; letter-spacing:-.025em; overflow-wrap:anywhere; } .project-subtitle { display:flex; flex-wrap:wrap; gap:6px 12px; color:var(--muted); font-size:12px; } .project-subtitle span { overflow-wrap:anywhere; } .project-summary { display:flex; align-items:center; gap:8px; align-self:start; }
    .project-body { display:grid; grid-template-columns:minmax(210px,.52fr) minmax(0,1.48fr); } .project-overview { padding:18px 20px 20px; border-right:1px solid var(--line); background:rgba(9,13,20,.28); } .overview-label { margin:0 0 12px; color:#c3ccd9; font-size:11px; font-weight:900; letter-spacing:.08em; text-transform:uppercase; } .metric-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; } .metric { padding:11px; border:1px solid var(--line); border-radius:12px; background:var(--soft); } .metric strong { display:block; font-size:18px; } .metric span { display:block; margin-top:3px; color:var(--muted); font-size:10px; } .project-config-actions { display:grid; gap:8px; margin-top:14px; } .project-config-actions .action-button { width:100%; min-height:36px; font-size:12px; }
    .service-area { padding:18px 20px 20px; } .service-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:9px; } .service { display:grid; align-content:start; min-height:148px; padding:13px; border:1px solid var(--line); border-radius:13px; background:var(--soft); } .service-head { display:flex; align-items:center; justify-content:space-between; gap:8px; } .service h4 { margin:0; font-size:13px; } .service p { margin:9px 0 0; color:var(--muted); font-size:11px; line-height:1.45; overflow-wrap:anywhere; } .service .action-button { justify-self:start; min-height:30px; margin-top:11px; padding:0 9px; font-size:10px; }
    .project-editor { border-top:1px solid var(--line); } .project-editor summary { padding:13px 20px; color:var(--muted); font-size:12px; cursor:pointer; list-style:none; } .project-editor summary::-webkit-details-marker { display:none; } .project-editor[open] summary { color:var(--text); border-bottom:1px solid var(--line); }
    .config-form { display:grid; gap:15px; padding:20px; } .form-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; } .field { display:grid; gap:6px; min-width:0; } .field.full { grid-column:1/-1; } .field label { color:#c2cbd8; font-size:11px; font-weight:800; } .field small { color:var(--muted); font-size:10px; line-height:1.4; } .field input,.field select,.field textarea { width:100%; min-height:42px; padding:9px 11px; border:1px solid var(--line2); border-radius:10px; outline:none; background:#0b1018; color:var(--text); transition:150ms ease; } .field textarea { min-height:120px; resize:vertical; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:11px; line-height:1.55; } .field input:focus,.field select:focus,.field textarea:focus { border-color:var(--blue); box-shadow:0 0 0 3px var(--blue-bg); } .field input:disabled { color:#8792a3; background:#10151e; } .form-actions { display:flex; align-items:center; gap:10px; } .form-message { color:var(--muted); font-size:12px; }
    .connect-panel { padding:clamp(20px,3vw,30px); border:1px solid var(--line); border-radius:20px; background:linear-gradient(135deg,rgba(23,29,41,.95),rgba(13,18,26,.95)); } .connect-panel .config-form { padding:0; } .connect-intro { display:grid; grid-template-columns:1fr auto; gap:18px; margin-bottom:22px; } .connect-intro h2 { margin:0; font-size:24px; letter-spacing:-.03em; } .connect-intro p { max-width:760px; margin:7px 0 0; color:var(--muted); font-size:13px; line-height:1.55; } .connect-badge { align-self:start; padding:8px 11px; border:1px solid #44536b; border-radius:999px; color:#b9c7dc; font-size:11px; } .empty { padding:30px; border:1px dashed var(--line2); border-radius:16px; color:var(--muted); text-align:center; } .footer { display:flex; justify-content:space-between; gap:20px; margin-top:22px; color:var(--muted); font-size:11px; }
    @media(max-width:1180px){.system-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.service-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:860px){.hero{grid-template-columns:1fr}.project-body{grid-template-columns:1fr}.project-overview{border-right:0;border-bottom:1px solid var(--line)}.metric-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
    @media(max-width:680px){.shell{width:min(100% - 20px,1440px);padding-top:12px}.topbar,.footer{align-items:stretch;flex-direction:column}.connect-intro{grid-template-columns:1fr}.nav{width:100%}.nav>*{flex:1}.hero{padding:23px 18px;border-radius:18px}.hero h2{font-size:38px}.system-grid,.service-grid,.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.project-header{grid-template-columns:1fr;padding:18px}.metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.project-overview,.service-area{padding:16px}.section-heading{align-items:start;flex-direction:column;gap:6px}}
  </style>
</head>
<body>
<main class="shell">
  <header class="topbar"><div class="brand"><div class="mark">AI</div><div><h1>AI Docs Hub</h1><p>Project control center</p></div></div><nav class="nav"><button class="button primary" id="refresh" type="button">Обновить</button><a class="link-button" href="/">Документация</a></nav></header>
  <section class="hero" id="hero" data-state="loading">
    <div class="hero-main"><div class="eyebrow"><span class="state-dot"></span><span id="stateLabel">Проверяю инфраструктуру</span></div><h2 id="headline">Собираю картину хаба</h2><p class="hero-copy" id="summaryText">Runtime, проекты и подключаемые подсистемы появятся после первой проверки.</p><div class="hero-meta"><span class="meta-chip" id="checkedAt">Последняя проверка: —</span><span class="meta-chip" id="projectCount">Проекты: —</span><span class="meta-chip">localhost:4321</span></div><div class="error-box" id="errorBox"></div>
      <div class="operation-panel" id="operationPanel" data-visible="false" data-state="idle"><div class="operation-head"><span id="operationTitle">Операция</span><span id="operationState">Ожидание</span></div><p class="operation-message" id="operationMessage"></p><div class="operation-progress"><span></span></div><p class="operation-meta" id="operationMeta"></p></div>
    </div><aside class="hero-side"><h3>Сейчас важно</h3><div id="nextSteps"><div class="next-step">Получаю актуальные данные.</div></div></aside>
  </section>
  <section class="section"><div class="section-heading"><div><h2>Системы хаба</h2><p>Общая инфраструктура, которая работает независимо от конкретных проектов.</p></div><span class="section-count">global scope</span></div><div class="system-grid" id="systems"></div></section>
  <section class="section"><div class="section-heading"><div><h2>Проекты</h2><p>Каждый проект — самостоятельный контур: конфигурация, мониторинг и подключаемые подсистемы.</p></div><span class="section-count" id="projectsLabel">0 проектов</span></div><div class="projects" id="projects"></div></section>
  <section class="section connect-panel"><div class="connect-intro"><div><h2>Подключить новый проект</h2><p>Создаёт локальный project config с безопасными исключениями. После сохранения проект появится выше, где можно подключить нужные подсистемы.</p></div><span class="connect-badge">local config</span></div>
    <form class="config-form" id="newProjectForm" data-mode="create"><div class="form-grid">
      <div class="field"><label>Project ID</label><input aria-label="Project ID" id="newProject" name="project" required pattern="[a-z0-9][a-z0-9-]{1,62}" placeholder="my-project"><small>Стабильный slug, после создания не меняется.</small></div><div class="field"><label>Название</label><input aria-label="Название проекта" name="title" required placeholder="My Project"></div>
      <div class="field full"><label>Путь к проекту</label><input aria-label="Путь к проекту" name="root" required placeholder="${AI_DOCS_PROJECTS_ROOT}/my-project"><small>Лучше использовать переносимый путь через AI_DOCS_PROJECTS_ROOT.</small></div><div class="field"><label>Namespace</label><input aria-label="Namespace" id="newNamespace" name="namespace" required placeholder="my-project"></div>
      <div class="field"><label>Docs backend</label><select aria-label="Docs backend" name="docs_backend"><option value="auto">Auto</option><option value="standard">Standard</option><option value="mkdocs">MkDocs</option></select></div><div class="field"><label>MkDocs config</label><input aria-label="MkDocs config" name="mkdocs_config" value="mkdocs.yml"></div>
      <div class="field"><label>Include paths</label><textarea aria-label="Include paths" name="include">README.md
AGENTS.md
docs/**/*.md</textarea></div><div class="field"><label>Дополнительные exclude paths</label><textarea aria-label="Дополнительные exclude paths" name="exclude" placeholder="Базовые secret-excludes добавятся автоматически."></textarea></div>
    </div><div class="form-actions"><button class="action-button primary" type="submit">Подключить проект</button><span class="form-message"></span></div></form>
  </section>
  <footer class="footer"><span>Live status обновляется каждые 10 секунд, кроме открытого редактирования.</span><span id="apiPath">Источник: /api/hub-status.json</span></footer>
</main>
<script is:inline>
  const fixApiBase='http://127.0.0.1:4322';
  const systemDefs={runtime:['RT','Runtime'],'docs-site':['UI','Docs site'],repository:['HC','Repository health'],mcp:['MC','MCP bridge'],watcher:['WA','Watcher']};
  const serviceDefs=[['rag','Docs RAG','Проектный индекс документов'],['generated','Generated context','Project page и llms context'],['mkdocs','Source discovery','MkDocs adapter и effective paths'],['docs-readiness','Docs readiness','Покрытие и рекомендации'],['skill-intelligence','Skill Intelligence','Свежесть skills audit'],['project-lifecycle','Project lifecycle','Patch gate и reviews'],['codebase-memory','Code graph','Граф кода, MCP и routing rules']];
  const hero=document.getElementById('hero'),refreshButton=document.getElementById('refresh'),operationPanel=document.getElementById('operationPanel'); let refreshing=false,fixing=false,saving=false;
  function el(tag,cls,text){const n=document.createElement(tag);if(cls)n.className=cls;if(text!==undefined)n.textContent=text;return n}
  function fmt(value){if(!value)return'—';const d=new Date(value);return Number.isNaN(d.getTime())?String(value):d.toLocaleString('ru-RU',{dateStyle:'short',timeStyle:'medium'})}
  function state(value){const s=String(value||'missing').toLowerCase();return ['up','healthy','fresh','indexed','available','ready','publishable','audited'].includes(s)?'ok':['degraded','partial','unknown'].includes(s)?'warning':s}
  function pill(value,text){const n=el('span','status-pill',text||value||'unknown');n.dataset.state=state(value);return n}
  function rows(component){return Array.isArray(component?.details?.projects)?component.details.projects:[]}
  function projectRow(components,name,project){return rows(components[name]).find(r=>r.project===project)||{}}
  function action(actionName,project,label){const b=el('button','action-button',label);b.type='button';b.dataset.fixAction=actionName;if(project)b.dataset.fixProject=project;return b}
  function renderHero(payload,projects){const status=payload.status||'down';hero.dataset.state=status;const copy=status==='up'?['Хаб в рабочем состоянии','Все обязательные контуры отвечают. Управляйте подключениями и наблюдайте за проектами из единого интерфейса.']:status==='degraded'?['Хаб работает, есть замечания','Основные функции доступны, но отдельным подсистемам или проектам требуется внимание.']:['Хаб требует вмешательства','Одна или несколько обязательных систем недоступны. Начните с подсказок справа.'];document.getElementById('headline').textContent=copy[0];document.getElementById('summaryText').textContent=copy[1];document.getElementById('stateLabel').textContent=status==='up'?'Все системы в норме':status==='degraded'?'Работа с ограничениями':'Есть критическая проблема';document.getElementById('checkedAt').textContent=`Проверено: ${fmt(payload.checked_at)}`;document.getElementById('projectCount').textContent=`Проекты: ${projects.length}`;const c=payload.components||{},steps=[];if(c.runtime?.status!=='ok')steps.push('Проверьте runtime и запустите make hub-dev.');if(c['docs-site']?.status!=='ok')steps.push('Проверьте docs-site через make hub-logs.');if(c.repository?.status==='error')steps.push('Исправьте repository healthcheck.');if(c.mcp?.status!=='ok')steps.push('Проверьте MCP командой make mcp-test.');if(!steps.length)steps.push('Обязательная инфраструктура отвечает. Можно работать с проектами.');const h=document.getElementById('nextSteps');h.textContent='';steps.forEach(t=>{const n=el('div','next-step',t);if(status==='up')n.dataset.kind='ok';h.append(n)})}
  function renderSystems(c){const h=document.getElementById('systems');h.textContent='';Object.entries(systemDefs).forEach(([name,[icon,title]])=>{const x=c[name]||{status:'missing',message:'Нет данных.'},card=el('article','system-card'),top=el('div','card-top');top.append(el('span','system-icon',icon),pill(x.status,x.status));card.append(top,el('h3','',title),el('p','',x.message||'Нет диагностического сообщения.'));if(name==='runtime'&&x.status!=='ok'){const installed=x.details?.launchd?.installed;card.append(action(installed?'runtime.start':'runtime.install-start','',installed?'Запустить':'Установить и запустить'))}if(name==='docs-site'&&x.status!=='ok')card.append(action('docs-site.restart','','Перезапустить'));h.append(card)})}
  function serviceState(key,r){if(key==='rag')return r.indexed&&!r.stale?'connected':r.status||'missing';if(key==='generated')return r.page_exists&&r.context_included?'connected':'missing';if(key==='mkdocs')return r.enabled||r.backend==='standard'?'connected':r.requested?'attention':'missing';if(key==='docs-readiness')return r.recommendations_count?'attention':r.status==='unknown'?'missing':'connected';if(key==='skill-intelligence')return r.status==='audited'&&r.freshness!=='stale'?'connected':r.status||'missing';if(key==='project-lifecycle')return r.publishable?'connected':r.status==='NO_PATCH'?'ok':r.status||'missing';if(key==='codebase-memory')return r.fully_connected?'connected':r.status==='indexed'?'attention':'missing';return r.status||'missing'}
  function serviceText(key,r){if(key==='rag')return r.indexed?`${r.documents_count??0} docs · ${r.chunks_count??0} chunks${r.stale?' · stale':''}`:r.message||'Индекс ещё не создан';if(key==='generated')return r.page_exists?`Project page: ${r.context_included?'в context':'не включена'}`:'Generated page отсутствует';if(key==='mkdocs')return`Backend: ${r.backend||'unknown'}${r.config_path?` · ${r.config_path}`:''}`;if(key==='docs-readiness')return`Покрытие ${r.coverage_percent??0}% · рекомендаций ${r.recommendations_count??0}`;if(key==='skill-intelligence')return`${r.skill_count??0} skills · ${r.candidate_count??0} candidates · ${r.warning_count??0} warnings`;if(key==='project-lifecycle')return`Gate: ${r.status||'missing'} · verification ${r.verification||'missing'}`;if(key==='codebase-memory')return`${r.nodes??0} nodes · MCP ${r.mcp_configured?'on':'off'} · rules ${r.agent_rules_installed?'on':'off'}`;return'Нет данных'}
  function serviceAction(key,r,s){if(key==='rag')return['rag.reindex',r.indexed?'Актуализировать':'Подключить RAG'];if(key==='generated'&&s!=='connected')return['generated.refresh','Собрать context'];if(key==='skill-intelligence')return['skill-audit',r.audit_available?'Обновить audit':'Запустить audit'];if(key==='project-lifecycle'){if(r.init_status!=='initialized')return['project-onboard','Подключить lifecycle'];if(r.quality_profile_status!=='available')return['quality-profile','Собрать profile'];if(r.status!=='NO_PATCH'&&r.verification!=='passed')return['verify-patch','Проверить patch']}if(key==='codebase-memory'&&s!=='connected')return['codebase-memory.index',r.status==='indexed'?'Завершить подключение':'Подключить graph'];return null}
  function lines(a){return Array.isArray(a)?a.join('\n'):''}
  function editor(p){const d=el('details','project-editor');d.append(el('summary','','Редактировать конфигурацию проекта'));const f=el('form','config-form');f.dataset.mode='update';f.innerHTML=`<div class="form-grid"><div class="field"><label>Project ID</label><input aria-label="Project ID" name="project" disabled></div><div class="field"><label>Название</label><input aria-label="Название проекта" name="title" required></div><div class="field full"><label>Путь к проекту</label><input aria-label="Путь к проекту" name="root" required><small>Можно использовать \${AI_DOCS_PROJECTS_ROOT}.</small></div><div class="field"><label>Namespace</label><input aria-label="Namespace" name="namespace" required></div><div class="field"><label>Docs backend</label><select aria-label="Docs backend" name="docs_backend"><option value="auto">Auto</option><option value="standard">Standard</option><option value="mkdocs">MkDocs</option></select></div><div class="field"><label>MkDocs config</label><input aria-label="MkDocs config" name="mkdocs_config"></div><div class="field"><label>Include paths</label><textarea aria-label="Include paths" name="include" required></textarea></div><div class="field"><label>Exclude paths</label><textarea aria-label="Exclude paths" name="exclude"></textarea></div></div><div class="form-actions"><button class="action-button primary" type="submit">Сохранить изменения</button><span class="form-message"></span></div>`;f.elements.project.value=p.project;f.elements.title.value=p.title||p.project;f.elements.root.value=p.root_source||'';f.elements.namespace.value=p.namespace||p.project;f.elements.docs_backend.value=p.docs_backend||'auto';f.elements.mkdocs_config.value=p.mkdocs_config||'mkdocs.yml';f.elements.include.value=lines(p.include);f.elements.exclude.value=lines(p.exclude);f.addEventListener('submit',submitConfig);d.append(f);return d}
  function projectCard(p,c){const card=el('article','project-card'),head=el('div','project-header'),identity=el('div','project-identity'),title=el('div','project-title'),initials=(p.title||p.project).split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase();title.append(el('h3','',p.title||p.project));const sub=el('div','project-subtitle');sub.append(el('span','',p.project),el('span','',`namespace: ${p.namespace||p.project}`),el('span','',p.root_source||p.root||'root не задан'));title.append(sub);identity.append(el('div','project-avatar',initials),title);const summary=el('div','project-summary'),connected=Number(p.connected_components_count||0),total=Number(p.components_count||3);summary.append(pill(p.status,p.status),pill(connected===total?'connected':'attention',`${connected}/${total} подключено`));head.append(identity,summary);card.append(head);const body=el('div','project-body'),overview=el('aside','project-overview');overview.append(el('p','overview-label','Обзор проекта'));const metrics=el('div','metric-grid');[[p.effective_include_count??p.include_count??0,'source patterns'],[p.effective_exclude_count??0,'exclude patterns'],[p.agent_rules_count??0,'agent rules'],[p.recommendations_count??0,'recommendations']].forEach(([v,l])=>{const m=el('div','metric');m.append(el('strong','',String(v)),el('span','',l));metrics.append(m)});overview.append(metrics);const area=el('div','service-area');area.append(el('p','overview-label','Подсистемы и мониторинг'));const grid=el('div','service-grid');serviceDefs.forEach(([key,name,description])=>{const r=projectRow(c,key,p.project),s=serviceState(key,r),service=el('section','service'),sh=el('div','service-head');sh.append(el('h4','',name),pill(s,s));service.append(sh,el('p','',serviceText(key,r)));const a=serviceAction(key,r,s);if(a)service.append(action(a[0],p.project,a[1]));grid.append(service)});area.append(grid);body.append(overview,area);card.append(body,editor(p));return card}
  function renderProjects(c){const ps=rows(c.projects),h=document.getElementById('projects');h.textContent='';document.getElementById('projectsLabel').textContent=`${ps.length} ${ps.length===1?'проект':'проектов'}`;if(!ps.length)h.append(el('div','empty','Подключённых проектов пока нет. Используйте форму ниже.'));ps.forEach(p=>h.append(projectCard(p,c)));return ps}
  function render(payload){document.body.dataset.error='false';const c=payload.components||{},ps=renderProjects(c);renderHero(payload,ps);renderSystems(c)}
  async function refresh(){if(refreshing||saving||document.querySelector('.project-editor[open]'))return;refreshing=true;refreshButton.disabled=true;refreshButton.textContent='Обновляю…';try{const r=await fetch(`/api/hub-status.json?ts=${Date.now()}`,{cache:'no-store'}),p=await r.json();if(!r.ok||p.error)throw new Error(p.error||`HTTP ${r.status}`);render(p);document.getElementById('apiPath').textContent=`Обновлено ${fmt(new Date().toISOString())}`}catch(e){document.body.dataset.error='true';hero.dataset.state='down';document.getElementById('errorBox').textContent=e instanceof Error?e.message:'Не удалось получить статус.'}finally{refreshing=false;refreshButton.disabled=false;refreshButton.textContent='Обновить'}}
  function showOp({action:act,project,state:st,message,jobId='',startedAt=Date.now()}){const labels={starting:'Запуск',queued:'В очереди',running:'Выполняется',ok:'Готово',error:'Ошибка'};operationPanel.dataset.visible='true';operationPanel.dataset.state=st;document.getElementById('operationTitle').textContent=`${act}${project?` · ${project}`:''}`;document.getElementById('operationState').textContent=labels[st]||st;document.getElementById('operationMessage').textContent=message;document.getElementById('operationMeta').textContent=[jobId?`job: ${jobId}`:'',`прошло: ${Math.max(0,Math.round((Date.now()-startedAt)/1000))} сек.`].filter(Boolean).join(' · ')}
  function fixMessage(p){return p?.result?.message||p?.error||p?.message||'Операция завершена'}
  async function pollJob(op,n=0){const r=await fetch(`${fixApiBase}/job?job_id=${encodeURIComponent(op.jobId)}`,{cache:'no-store'}),p=await r.json();if(['queued','running'].includes(p.status)&&n<90){showOp({...op,state:p.status,message:p.status==='queued'?'Задача ожидает выполнения.':'Подсистема выполняет операцию.'});await new Promise(x=>setTimeout(x,2000));return pollJob(op,n+1)}if(!r.ok||p.status!=='ok')throw new Error(fixMessage(p));showOp({...op,state:'ok',message:fixMessage(p)});await refresh()}
  async function applyFix(button){if(fixing)return;fixing=true;document.querySelectorAll('button[data-fix-action]').forEach(b=>b.disabled=true);const act=button.dataset.fixAction,project=button.dataset.fixProject||'',op={action:act,project,startedAt:Date.now()};showOp({...op,state:'starting',message:'Передаю команду локальному управляющему серверу.'});try{const q=new URLSearchParams({action:act});if(project)q.set('project',project);const r=await fetch(`${fixApiBase}/apply-fix?${q}`,{cache:'no-store'}),p=await r.json();if(!r.ok||p.status==='error')throw new Error(fixMessage(p));if(p.job_id){op.jobId=p.job_id;showOp({...op,state:'queued',message:'Задача принята.'});await pollJob(op)}else{showOp({...op,state:'ok',message:fixMessage(p)});await refresh()}}catch(e){showOp({...op,state:'error',message:e instanceof Error?e.message:'Неизвестная ошибка'})}finally{fixing=false;document.querySelectorAll('button[data-fix-action]').forEach(b=>b.disabled=false)}}
  function payload(form){const data=new FormData(form),value=n=>String(data.get(n)??form.elements[n]?.value??'').trim();return{mode:form.dataset.mode,project:value('project'),title:value('title'),root:value('root'),namespace:value('namespace'),docs_backend:value('docs_backend'),mkdocs_config:value('mkdocs_config'),include:value('include').split(/\r?\n/).map(x=>x.trim()).filter(Boolean),exclude:value('exclude').split(/\r?\n/).map(x=>x.trim()).filter(Boolean)}}
  async function submitConfig(event){event.preventDefault();if(saving)return;const form=event.currentTarget,msg=form.querySelector('.form-message'),button=form.querySelector('button[type=submit]');saving=true;button.disabled=true;msg.textContent='Сохраняю конфигурацию и обновляю документацию…';try{const r=await fetch(`${fixApiBase}/project-config`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload(form))}),p=await r.json();if(!r.ok||p.status!=='ok')throw new Error(p.error||`HTTP ${r.status}`);msg.textContent=p.mode==='create'?'Проект подключён, страницы и контекст обновлены.':'Конфигурация, страницы и контекст обновлены.';if(p.mode==='create')form.reset();document.querySelectorAll('.project-editor[open]').forEach(d=>d.open=false);saving=false;await refresh()}catch(e){msg.textContent=e instanceof Error?e.message:'Не удалось сохранить конфигурацию.'}finally{saving=false;button.disabled=false}}
  document.getElementById('newProjectForm').addEventListener('submit',submitConfig);document.getElementById('newProject').addEventListener('input',e=>{const n=document.getElementById('newNamespace');if(!n.dataset.touched)n.value=e.currentTarget.value});document.getElementById('newNamespace').addEventListener('input',e=>e.currentTarget.dataset.touched='true');refreshButton.addEventListener('click',refresh);document.addEventListener('click',e=>{const b=e.target instanceof Element?e.target.closest('button[data-fix-action]'):null;if(b)applyFix(b)});refresh();setInterval(refresh,10000);
</script>
